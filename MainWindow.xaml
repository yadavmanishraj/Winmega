<Window
    x:Class="Omega.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Omega.ViewModels"
    Title="Omega">

    <!-- Mica backdrop (design §9.1): first-party media apps differentiate
         via backdrop + accent. -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <!-- One transport language (AUDIT_2 V-02/V-03): the strip's
         transport buttons wear the same subtle discs as the Now
         Playing page's transport row, so glyphs read at a glance and
         hover/pressed states have a surface. On-state adds shape —
         a filled disc + a dot under the glyph (code-behind) — never
         colour alone (A-4). -->

    <!-- Shell (APPLE_LAYOUT_SPEC §1, supersedes design §9.1's
         SelectorBar strip + floating bar): a unified 64px title-bar
         strip — back + wordmark + endpoint status over the pane,
         transport cluster, the centred LCD well, and the
         volume/lyrics/queue cluster — over a NavigationView whose pane
         holds search, destinations, Library sub-sections and the
         user's playlists. Row 0 is layered: a background Border is
         the window's ONLY drag region (SetTitleBar target, set in
         code-behind) and the strip's content Grid is a SIBLING above
         it — no interactive element is a descendant of the drag
         element, so slider drags and button manipulations are never
         reinterpreted as window drags (POINTER QA F3). Green is
         spent the way Apple spends red: selection pill, play fill,
         on-states — never text or backgrounds (§0). -->
    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged" KeyDown="RootGrid_KeyDown">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F"
                                 Invoked="SearchAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Row 0: unified strip ============ -->
        <Grid Grid.Row="0">
            <!-- Drag surface only: transparent fill makes it
                 hit-test visible (a null background would not be);
                 it carries no content and no handlers. -->
            <Border x:Name="TitleBarDragRegion" Background="Transparent" />

            <Grid x:Name="TitleBarStrip" Loaded="TitleBarStrip_Loaded">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left segment (fixed 260 wide, never shrinks
                     with the pane): pane toggle, back (only when
                     navigation can go back), quiet wordmark. The
                     endpoint status dot/label that used to sit here
                     was removed (Manish, 2026-10-08): playback
                     failure honesty lives in the failure bar + the
                     player error surfaces, not a permanent label. -->
                <Grid Grid.Column="0" ColumnSpacing="4" Padding="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PaneToggleButton"
                            Grid.Column="0"
                            Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ShellPaneToggle"
                            Click="PaneToggle_Click">
                        <FontIcon Glyph="&#xE700;" FontSize="16" />
                    </Button>
                    <Button x:Name="BackButton"
                            Grid.Column="1"
                            Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center"
                            IsEnabled="False" Visibility="Collapsed"
                            ToolTipService.ToolTip="Back"
                            AutomationProperties.AutomationId="ShellBack"
                            AutomationProperties.Name="Back"
                            Click="BackButton_Click">
                        <SymbolIcon Symbol="Back" Width="16" Height="16" />
                    </Button>
                    <TextBlock x:Uid="AppWordmark" Grid.Column="2"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Transport cluster: binds PlayerViewModel (the page
                     VM), not the shell mirror. Shuffle/repeat on-state
                     = filled disc + green glyph + dot (code-behind),
                     plus the state in the accessible name. -->
                <StackPanel x:Name="TransportCluster" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                            Margin="8,0,0,0" VerticalAlignment="Center">
                    <ToggleButton x:Name="ShuffleButton"
                                  Style="{StaticResource StripTransportToggleStyle}"
                                  IsChecked="{x:Bind Player.IsShuffle, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Shuffle"
                                  AutomationProperties.AutomationId="TransportShuffle"
                                  AutomationProperties.Name="Shuffle off">
                        <Grid>
                            <Ellipse x:Name="ShuffleDisc" Width="40" Height="40" />
                            <SymbolIcon x:Name="ShuffleIcon" Symbol="Shuffle" Width="16" Height="16"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <Ellipse x:Name="ShuffleStateDot" Width="4" Height="4"
                                     HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                     Margin="0,0,0,4" Visibility="Collapsed"
                                     Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Grid>
                    </ToggleButton>
                    <Button Style="{StaticResource StripTransportButtonStyle}"
                            Command="{x:Bind Player.PreviousTrackCommand}"
                            ToolTipService.ToolTip="Previous"
                            AutomationProperties.AutomationId="TransportPrevious"
                            AutomationProperties.Name="Previous">
                        <SymbolIcon Symbol="Previous" Width="16" Height="16"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                    <Button Style="{StaticResource StripTransportButtonStyle}"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Command="{x:Bind Player.TogglePlayPauseCommand}"
                            ToolTipService.ToolTip="Play or pause"
                            AutomationProperties.AutomationId="NowPlayingPlayPause"
                            AutomationProperties.Name="Play or pause">
                        <SymbolIcon Symbol="{x:Bind Player.PlayPauseSymbol, Mode=OneWay}" Width="16" Height="16"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Button>
                    <Button Style="{StaticResource StripTransportButtonStyle}"
                            Command="{x:Bind Player.NextTrackCommand}"
                            ToolTipService.ToolTip="Next"
                            AutomationProperties.AutomationId="TransportNext"
                            AutomationProperties.Name="Next">
                        <SymbolIcon Symbol="Next" Width="16" Height="16"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                    <Button x:Name="RepeatButton"
                            Style="{StaticResource StripTransportButtonStyle}"
                            Command="{x:Bind Player.CycleRepeatCommand}"
                            ToolTipService.ToolTip="Repeat"
                            AutomationProperties.AutomationId="TransportRepeat"
                            AutomationProperties.Name="Repeat off">
                        <Grid>
                            <Ellipse x:Name="RepeatDisc" Width="40" Height="40" />
                            <SymbolIcon x:Name="RepeatIcon" Width="16" Height="16"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Symbol="{x:Bind Player.RepeatSymbol, Mode=OneWay}" />
                            <Ellipse x:Name="RepeatStateDot" Width="4" Height="4"
                                     HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                     Margin="0,0,0,4" Visibility="Collapsed"
                                     Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- LCD well: artwork + centred title/artist over a 2px
                     progress hairline. The artwork/text zone is one
                     Button (the NowPlayingOpen target carrying the
                     well's single UIA name, refreshed in code-behind);
                     the trailing ••• menu is a sibling, never nested
                     in that Button. Width is capped (AUDIT_2 V-01):
                     a quiet readout, not a banner; idle shows a
                     placeholder artwork tile (code-behind toggles it
                     against CurrentArtworkSource). -->
                <Border x:Name="LcdWell" Grid.Column="2"
                        MaxWidth="460" Height="48"
                        Margin="24,0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="NowPlayingOpenButton"
                                    Grid.Column="0"
                                    Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    AutomationProperties.AutomationId="NowPlayingOpen"
                                    AutomationProperties.Name="Nothing playing"
                                    Click="NowPlayingOpen_Click">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="44" Height="44">
                                        <Border x:Name="ArtworkPlaceholder"
                                                Width="44" Height="44"
                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                CornerRadius="4">
                                            <SymbolIcon Symbol="MusicInfo"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                        </Border>
                                        <Image Width="44" Height="44"
                                               Stretch="UniformToFill"
                                               Source="{x:Bind Player.CurrentArtworkSource, Mode=OneWay}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                        <TextBlock Text="{x:Bind Player.CurrentTitle, Mode=OneWay}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="LcdArtistText"
                                                   Text="{x:Bind Player.CurrentArtist, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryCaptionStyle}"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button x:Name="LcdMoreButton"
                                    Grid.Column="1"
                                    Width="40" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    VerticalAlignment="Stretch"
                                    ToolTipService.ToolTip="More actions"
                                    AutomationProperties.AutomationId="LcdMore"
                                    AutomationProperties.Name="More actions">
                                <SymbolIcon Symbol="More" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Uid="GoToNowPlaying"
                                                        Click="GoToNowPlayingMenuItem_Click" />
                                        <MenuFlyoutItem x:Uid="OpenQueue"
                                                        Click="OpenQueueMenuItem_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <!-- Progress at rest is neutral (spec §0):
                             primary text fill over a faint track, never
                             green. -->
                        <ProgressBar Grid.Row="1"
                                     Height="2"
                                     Minimum="0"
                                     Maximum="{x:Bind Player.DurationSeconds, Mode=OneWay}"
                                     Value="{x:Bind Player.PositionSeconds, Mode=OneWay}"
                                     Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                     Background="{ThemeResource TextFillColorDisabledBrush}" />
                    </Grid>
                </Border>

                <!-- Right cluster: volume, lyrics, queue. -->
                <StackPanel x:Name="RightCluster" Grid.Column="3" Orientation="Horizontal" Spacing="4"
                            Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button x:Name="VolumeButton"
                            Width="40" Height="40" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Volume"
                            AutomationProperties.AutomationId="VolumeButton"
                            AutomationProperties.Name="Volume"
                            Click="VolumeButton_Click">
                        <SymbolIcon x:Name="VolumeIcon" Symbol="Volume" />
                    </Button>
                    <!-- Collapsed below ~1100 DIP window width in
                         code-behind (AUDIT_2 R-2): the mute toggle
                         remains, every command stays reachable. -->
                    <Slider x:Name="VolumeSlider"
                            Width="100"
                            Minimum="0" Maximum="100" StepFrequency="1"
                            VerticalAlignment="Center"
                            Value="{x:Bind Player.Volume, Mode=TwoWay}"
                            AutomationProperties.AutomationId="VolumeSlider"
                            AutomationProperties.Name="Volume" />
                    <!-- Lyrics + Queue are quick-view flyouts now
                         (approved sample, 2026-10-07): the strip click
                         opens the flyout instead of navigating away.
                         Flyout content is declared inline in this
                         window (no dictionary-hosted templates) and
                         binds the same Player VM as the rest of the
                         strip. -->
                    <Button Width="40" Height="40" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Lyrics"
                            AutomationProperties.AutomationId="LyricsButton"
                            AutomationProperties.Name="Lyrics">
                        <SymbolIcon Symbol="Message" />
                        <Button.Flyout>
                            <Flyout x:Name="LyricsFlyout"
                                    Placement="BottomEdgeAlignedRight"
                                    Opening="LyricsFlyout_Opening"
                                    Closed="LyricsFlyout_Closed">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <Grid Width="384" MaxHeight="472">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="LyricsFlyoutHeader" Grid.Row="0"
                                               Margin="16,14,16,0"
                                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="LyricsFlyoutMeta" Grid.Row="1"
                                               Margin="16,2,16,0"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ScrollViewer Grid.Row="2" Margin="0,8,0,0"
                                                  VerticalScrollBarVisibility="Auto">
                                        <Grid Margin="16,0,16,12">
                                            <TextBlock x:Name="LyricsFlyoutText"
                                                       FontSize="15" LineHeight="28"
                                                       TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True"
                                                       AutomationProperties.AutomationId="LyricsFlyoutText"
                                                       AutomationProperties.Name="Lyrics" />
                                            <!-- Status surface: loading /
                                                 unavailable / failed states
                                                 replace the body text, so
                                                 the panel always says what
                                                 happened (the Now Playing
                                                 page's rule). -->
                                            <StackPanel x:Name="LyricsFlyoutStatus" Spacing="10"
                                                        Margin="0,28,0,28"
                                                        HorizontalAlignment="Center"
                                                        Visibility="Collapsed">
                                                <ProgressRing x:Name="LyricsFlyoutProgress"
                                                              Width="28" Height="28"
                                                              HorizontalAlignment="Center"
                                                              IsActive="False" />
                                                <TextBlock x:Name="LyricsFlyoutStatusText"
                                                           Style="{StaticResource SecondaryTextStyle}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <Button x:Name="LyricsFlyoutRetry"
                                                        HorizontalAlignment="Center"
                                                        Click="LyricsFlyoutRetry_Click"
                                                        Visibility="Collapsed"
                                                        AutomationProperties.AutomationId="LyricsFlyoutRetry" />
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>
                                    <Border Grid.Row="3"
                                            BorderThickness="0,1,0,0"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Padding="16,6">
                                        <TextBlock x:Name="LyricsFlyoutCopyright"
                                                   Style="{StaticResource SecondaryCaptionStyle}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="QueueButton" Width="40" Height="40" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Queue"
                            AutomationProperties.AutomationId="QueueButton"
                            AutomationProperties.Name="Queue">
                        <SymbolIcon Symbol="Bullets" />
                        <Button.Flyout>
                            <Flyout x:Name="QueueFlyout"
                                    Placement="BottomEdgeAlignedRight"
                                    Opening="QueueFlyout_Opening"
                                    Closed="QueueFlyout_Closed">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <Grid Width="384" MaxHeight="472">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Header: title, count, Clear. -->
                                    <Grid Grid.Row="0" Margin="16,14,16,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="QueueFlyoutHeader" Grid.Column="0"
                                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="QueueFlyoutCount" Grid.Column="1"
                                                   Style="{StaticResource SecondaryCaptionStyle}"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="ClearQueueButton" Grid.Column="2"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="8,4"
                                                Click="ClearQueueButton_Click"
                                                AutomationProperties.AutomationId="ClearQueueButton"
                                                AutomationProperties.Name="Clear queue" />
                                    </Grid>

                                    <!-- Now playing: pinned above the
                                         list, accent-marked (the app's
                                         selection colour spent on the
                                         title + bars, per spec §0). -->
                                    <StackPanel Grid.Row="1" Margin="8,0,8,0" Spacing="2">
                                        <TextBlock x:Name="QueueNowPlayingLabel" Margin="8,6,8,2"
                                                   Style="{StaticResource SecondaryCaptionStyle}" />
                                        <Border x:Name="QueueNowPlayingBlock"
                                                CornerRadius="{StaticResource CardCornerRadius}"
                                                Padding="8,6"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Width="40" Height="40">
                                                    <Border x:Name="QueueNowArtworkPlaceholder"
                                                            Width="40" Height="40"
                                                            Background="{ThemeResource LayerFillColorAltBrush}"
                                                            CornerRadius="4">
                                                        <SymbolIcon Symbol="MusicInfo"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center" />
                                                    </Border>
                                                    <Image Width="40" Height="40"
                                                           Stretch="UniformToFill"
                                                           Source="{x:Bind Player.CurrentArtworkSource, Mode=OneWay}" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                                    <TextBlock Text="{x:Bind Player.CurrentTitle, Mode=OneWay}"
                                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Player.CurrentArtist, Mode=OneWay}"
                                                               Style="{StaticResource SecondaryCaptionStyle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Grid Grid.Column="2" Height="14" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="2"
                                                                VerticalAlignment="Bottom">
                                                        <Rectangle Width="3" Height="6"
                                                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                                        <Rectangle Width="3" Height="12"
                                                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                                        <Rectangle Width="3" Height="8"
                                                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                                           Style="{StaticResource SecondaryCaptionStyle}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           Text="{x:Bind Player.DurationText, Mode=OneWay}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock x:Name="QueueUpNextLabel" Grid.Row="2"
                                               Margin="16,10,16,2"
                                               Style="{StaticResource SecondaryCaptionStyle}" />

                                    <!-- Up next: the live queue minus the
                                         current track (rebuilt in
                                         code-behind). Drag-reorder: the
                                         ListView rearranges the wrapper
                                         rows live; on drop the shell
                                         commits the dropped order via
                                         PlayerService.ReorderQueue,
                                         which permutes the play order
                                         (a queue-only permutation would
                                         leave the audible sequence
                                         unchanged — the service's remap
                                         follows songs, not slots). -->
                                    <ListView x:Name="QueueFlyoutList" Grid.Row="3"
                                              Margin="8,0,8,8"
                                              ItemsSource="{x:Bind UpNextItems}"
                                              SelectionMode="None"
                                              IsItemClickEnabled="True"
                                              CanReorderItems="True"
                                              AllowDrop="True"
                                              ItemClick="QueueFlyoutList_ItemClick"
                                              DragItemsStarting="QueueFlyoutList_DragItemsStarting"
                                              DragItemsCompleted="QueueFlyoutList_DragItemsCompleted"
                                              AutomationProperties.AutomationId="QueueFlyoutList"
                                              AutomationProperties.Name="Up next">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="MinHeight" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:QueueFlyoutItem">
                                                <Grid ColumnSpacing="10" Padding="8,6"
                                                      PointerEntered="QueueRow_PointerEntered"
                                                      PointerExited="QueueRow_PointerExited">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" Width="40" Height="40">
                                                        <Border Width="40" Height="40"
                                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                                CornerRadius="4">
                                                            <SymbolIcon Symbol="MusicInfo"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center" />
                                                        </Border>
                                                        <Image Width="40" Height="40"
                                                               Stretch="UniformToFill"
                                                               Source="{x:Bind Artwork}" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                                        <TextBlock Text="{x:Bind Title}"
                                                                   Style="{ThemeResource BodyTextBlockStyle}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Artist}"
                                                                   Style="{StaticResource SecondaryCaptionStyle}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                               Style="{StaticResource SecondaryCaptionStyle}"
                                                               Typography.NumeralAlignment="Tabular"
                                                               Text="{x:Bind Duration}" />
                                                    <Button Grid.Column="3"
                                                            Width="28" Height="28" Padding="0"
                                                            Background="Transparent" BorderThickness="0"
                                                            VerticalAlignment="Center"
                                                            Visibility="Collapsed"
                                                            Click="QueueRowRemove_Click"
                                                            ToolTipService.ToolTip="Remove from queue"
                                                            AutomationProperties.AutomationId="QueueRemoveButton"
                                                            AutomationProperties.Name="Remove from queue">
                                                        <SymbolIcon Symbol="Cancel" Width="12" Height="12" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <StackPanel x:Name="QueueFlyoutEmpty" Grid.Row="3"
                                                Spacing="6" Margin="16,26,16,30"
                                                HorizontalAlignment="Center"
                                                Visibility="Collapsed">
                                        <SymbolIcon Symbol="Bullets" HorizontalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="QueueFlyoutEmptyTitle"
                                                   HorizontalAlignment="Center"
                                                   Style="{ThemeResource BodyTextBlockStyle}" />
                                        <TextBlock x:Name="QueueFlyoutEmptyBody"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- Caption-button clearance: width set from
                     AppWindow.TitleBar.RightInset in code-behind. -->
                <Border x:Name="CaptionInsetSpacer" Grid.Column="4" />
            </Grid>
        </Grid>

        <!-- ============ Row 1: shell failure bar (AUDIT_3 M2) ============
             Playback/navigation failures used to render only inside
             the Now Playing surface; everywhere else a failed track
             was a silent stop. This slim bar surfaces the same state
             at shell level, on every page, until dismissed. -->
        <Border x:Name="FailureBar" Grid.Row="1"
                Visibility="Collapsed"
                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                Padding="12,4,4,4">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FailureBarText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Dismiss"
                        AutomationProperties.AutomationId="ShellFailureDismiss"
                        AutomationProperties.Name="Dismiss"
                        Click="FailureDismiss_Click">
                    <SymbolIcon Symbol="Cancel" Width="12" Height="12" />
                </Button>
            </Grid>
        </Border>

        <!-- ============ Row 2: NavigationView + content, with the
             Now Playing panel docked in a real layout column beside
             it (approved panel design: NOT an overlay — the
             NavigationView narrows and the page reflows). The host
             grid stays empty (width 0) while the panel is closed;
             the panel control itself is created on open and removed
             on close by code-behind. ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <NavigationView x:Name="ShellNav"
                        Grid.Column="0"
                        PaneDisplayMode="Auto"
                        OpenPaneLength="260"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        ItemInvoked="ShellNav_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHomeItem" x:Uid="NavHome" Tag="home"
                                    AutomationProperties.AutomationId="NavHome">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Search is a plain section row (Manish,
                     2026-10-08): the input itself lives at the top
                     of SearchPage — no text field in the pane. -->
                <NavigationViewItem x:Name="NavSearchItem" x:Uid="NavSearch" Tag="search"
                                    AutomationProperties.AutomationId="NavSearch">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Uid="SidebarLibraryHeader" />
                <NavigationViewItem x:Name="NavLibraryItem" x:Uid="NavLibrary" Tag="library"
                                    AutomationProperties.AutomationId="NavLibrary">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavRecentItem" x:Uid="NavRecentlyAdded" Tag="library:history"
                                    AutomationProperties.AutomationId="NavRecentlyAdded">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Clock" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavArtistsItem" x:Uid="NavArtists" Tag="library:artists"
                                    AutomationProperties.AutomationId="NavLibArtists">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="People" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAlbumsItem" x:Uid="NavAlbums" Tag="library:albums"
                                    AutomationProperties.AutomationId="NavLibAlbums">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="BrowsePhotos" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSongsItem" x:Uid="NavSongs" Tag="library:songs"
                                    AutomationProperties.AutomationId="NavLibSongs">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Audio" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Uid="SidebarPlaylistsHeader" />
                <!-- Dynamic playlist items are inserted in code-behind
                     between this header and the New playlist item. -->
                <NavigationViewItem x:Name="NavNewPlaylistItem" x:Uid="NavNewPlaylist" Tag="library:newplaylist"
                                    AutomationProperties.AutomationId="NavNewPlaylist">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Add" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <!-- Footer items are hosted by the pane's footer
                     presenter, OUTSIDE the menu list's invocation
                     pipeline: real-pointer QA proved this item never
                     selected and never raised SelectionChanged while
                     every menu item worked. The Tapped route feeds the
                     same navigation path explicitly (harmless if the
                     pipeline also delivers ItemInvoked — the section
                     navigation is idempotent). It must never assign
                     this item to NavigationView.SelectedItem: the
                     selection model only resolves MenuItems, and
                     selecting a footer item throws (0xC000027B,
                     live-traced 2026-10-07). -->
                <NavigationViewItem x:Name="NavSettingsItem" x:Uid="NavSettings" Tag="settings"
                                    AutomationProperties.AutomationId="NavSettings"
                                    Tapped="NavSettingsItem_Tapped">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.PaneFooter>
            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </NavigationView>
        <!-- Now Playing panel host: empty while the panel is
             closed. Code-behind adds the fresh panel control here
             on open and removes (disposes) it after the close
             slide. -->
        <Grid x:Name="NowPlayingPanelHost" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
