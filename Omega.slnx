<Solution>
  <Configurations>
    <Platform Name="ARM64" />
    <Platform Name="x64" />
  </Configurations>
  <Project Path="Omega.csproj">
    <Platform Solution="*|ARM64" Project="ARM64" />
    <Platform Solution="*|x64" Project="x64" />
    <Deploy />
  </Project>
  <Project Path="src/Omega.Core/Omega.Core.csproj">
    <Platform Solution="*|ARM64" Project="Any CPU" />
    <Platform Solution="*|x64" Project="Any CPU" />
  </Project>
  <Project Path="tests/Omega.Core.Tests/Omega.Core.Tests.csproj">
    <Platform Solution="*|ARM64" Project="Any CPU" />
    <Platform Solution="*|x64" Project="Any CPU" />
  </Project>
</Solution>
