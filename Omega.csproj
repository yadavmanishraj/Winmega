<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Upgraded 2026-10-07 from the VS template defaults
         (net8.0-windows10.0.19041.0): .NET 10 + Windows SDK 26100,
         matching the verified Omega.Core (plain net10.0) and the
         Omega Windows design (WINDOWS_APP_DESIGN.md §2.1). -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Omega</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- x64 / ARM64 only — never AnyCPU, no x86 (design §2.1). -->
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>

    <!-- Native AOT: persistent project intent (HARD REQUIREMENT,
         design §3.1). PublishAot=true also turns trim/AOT analysis ON
         during development builds, so violations surface in the inner
         loop, not at release. IRON RULE: fix IL/CsWinRT warnings —
         never suppress them. -->
    <PublishAot>true</PublishAot>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <!-- CsWinRTAotOptimizerEnabled defaults to True (Auto) — do not turn it off. -->
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!-- Shell dependencies (ported from omega-winui, verified pins):
         MVVM Toolkit >= 8.4 for partial-property [ObservableProperty]
         (the AOT-safe form); DI 10.0.0 for the explicit composition
         root in App.xaml.cs — no scanning, no open generics. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\Omega.Core\Omega.Core.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- NOTE: the template's PublishReadyToRun / conditioned PublishTrimmed
       block was removed in the .NET 10 upgrade: ReadyToRun is a JIT-only
       optimization and conflicts with the Native AOT intent above, and
       PublishAot already carries trimming into publish. -->
</Project>
