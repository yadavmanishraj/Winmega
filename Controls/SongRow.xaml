<UserControl
    x:Class="Omega.Controls.SongRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- THE shared song row (AUDIT_2 §8.1): one row for every song
         list in the app (Home, Search, Library, Detail) — the four
         page-local copies had diverged, and the inline Button.Flyout
         pattern failed under real pointer input (POINTER_QA F4).
         Structural rules: favourite and More are sibling buttons on
         their own Auto columns (44px each, 12px spacing, no shared
         cell, no overlap); Play is also on the artwork (hover disc),
         so the menu is never the only route to play.
         WHY A USERCONTROL (D1): this markup previously lived in a
         DataTemplate hosted by a standalone merged ResourceDictionary
         (Templates/SongRowTemplates.xaml), where its bindings never
         evaluated at runtime in either flavour (POINTER_QA2 +
         Manish's Detail screenshot). A UserControl is the standard
         codegen-proven host for a reusable row (same model as a
         Page): pages hand it the item through the ViewModel
         dependency property, and every binding below is a compiled
         {x:Bind ViewModel.<path>, Mode=OneWay} rooted at that
         property — typed against SongItemViewModel, so the bindings
         are trimming/AOT clean (no WMC1510), and they re-evaluate
         when the property changes (recycled rows). Do not move this
         back into a shared ResourceDictionary template. -->
    <Grid ColumnSpacing="12" Padding="4,4" MinHeight="56">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Width="48" Height="48">
            <Image Source="{x:Bind ViewModel.Artwork, Mode=OneWay}" Width="48" Height="48" Stretch="UniformToFill"
                   AutomationProperties.AccessibilityView="Raw" />
            <Button Width="28" Height="28" Padding="0" CornerRadius="14"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.PlayCommand, Mode=OneWay}"
                    AutomationProperties.AutomationId="SongArtworkPlayButton"
                    AutomationProperties.Name="Play">
                <FontIcon Glyph="&#xE768;" FontSize="12" />
            </Button>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind ViewModel.Artists, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}"
                   Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                Command="{x:Bind ViewModel.ToggleFavoriteCommand, Mode=OneWay}"
                AutomationProperties.AutomationId="SongFavoriteButton"
                AutomationProperties.Name="{x:Bind ViewModel.FavoriteMenuText, Mode=OneWay}">
            <FontIcon Glyph="{x:Bind ViewModel.FavoriteGlyph, Mode=OneWay}" FontSize="18" />
        </Button>
        <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                AutomationProperties.AutomationId="SongMoreButton"
                AutomationProperties.Name="{x:Bind ViewModel.MoreActionsName, Mode=OneWay}">
            <FontIcon Glyph="&#xE712;" FontSize="18" />
            <Button.Flyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="PlayMenuItem" Command="{x:Bind ViewModel.PlayCommand, Mode=OneWay}"
                                    AutomationProperties.AutomationId="SongPlayMenuItem" />
                    <MenuFlyoutItem x:Uid="PlayNextMenuItem" Command="{x:Bind ViewModel.PlayNextCommand, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.CanPlayNext, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                    AutomationProperties.AutomationId="SongPlayNextMenuItem" />
                    <MenuFlyoutItem x:Uid="AddToQueueMenuItem" Command="{x:Bind ViewModel.AddToQueueCommand, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.CanAddToQueue, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                    AutomationProperties.AutomationId="SongAddToQueueMenuItem" />
                    <MenuFlyoutItem Text="{x:Bind ViewModel.FavoriteMenuText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ToggleFavoriteCommand, Mode=OneWay}"
                                    AutomationProperties.AutomationId="SongFavoriteMenuItem" />
                    <MenuFlyoutItem x:Uid="AddToPlaylistMenuItem" Command="{x:Bind ViewModel.AddToPlaylistCommand, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanAddToPlaylist, Mode=OneWay}"
                                    AutomationProperties.AutomationId="SongAddToPlaylistMenuItem" />
                    <MenuFlyoutItem x:Uid="DownloadMenuItem" Command="{x:Bind ViewModel.DownloadCommand, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.CanDownload, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                    AutomationProperties.AutomationId="SongDownloadMenuItem" />
                    <MenuFlyoutItem Text="{x:Bind ViewModel.RemoveMenuText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RemoveCommand, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.CanRemove, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                    AutomationProperties.AutomationId="SongRemoveMenuItem" />
                </MenuFlyout>
            </Button.Flyout>
        </Button>
    </Grid>
</UserControl>
