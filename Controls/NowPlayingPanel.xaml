<UserControl
    x:Class="Omega.Controls.NowPlayingPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Omega.Controls"
    SizeChanged="NowPlayingPanel_SizeChanged">

    <!-- THE Now Playing surface (approved panel design, 2026-10-07;
         replaces the retired full-page player). A shell-docked pane,
         NOT an overlay: MainWindow hosts it in a real layout column
         beside the NavigationView and animates its Width 0<->W, so
         the content column narrows and reflows while the panel is
         open. The shell creates a FRESH instance on every open and
         disposes it after the close slide, so nothing stale survives
         inside.

         Composition (direction A, NOW_PLAYING_POLISH §3, tightened
         per Manish's sample corrections 2026-10-08): identity zone
         pinned to the top (header, artwork, title block), controls
         zone pinned to the BOTTOM (times + seek, transport, menus)
         with deliberate air between them, so the transport never
         moves between tracks, widths, or window heights. Transport
         buttons are BARE GLYPHS — no discs or button backgrounds;
         state reads from the accent glyph + a small state dot (the
         strip's pattern). Only play/pause keeps its filled accent
         disc. Behind everything sits the FX layer (NOW_PLAYING_FX):
         a Composition host (FxHost) whose visuals paint the
         palette-driven gradient / particles / pulse for the mode
         read from settings at construction; mode Off leaves the
         static HeroTintBrush treatment below untouched.

         Bindings are compiled {x:Bind} rooted at this control's own
         PlayerViewModel instance (transient, disposed with the
         panel — the page's lifecycle), never classic bindings and
         never a dictionary-hosted template (the D1 rule). -->
    <UserControl.Resources>
        <!-- Panel transport (Manish, 2026-10-08): bare glyphs at a
             48px target — transparent rest, no border, no disc. The
             Button keeps the platform template (hover/pressed are
             transient interaction feedback); the ToggleButton gets a
             minimal template because the stock one paints a checked
             background, which would resurrect the disc exactly when
             shuffle is on. On-state is painted from code-behind:
             accent glyph + state dot. -->
        <Style x:Key="PanelTransportButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="24" />
        </Style>
        <Style x:Key="PanelTransportToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              Padding="{TemplateBinding Padding}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Checked" />
                                    <VisualState x:Name="CheckedPointerOver" />
                                    <VisualState x:Name="CheckedPressed" />
                                    <VisualState x:Name="Indeterminate" />
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Resize grip: hit-testable strip on the panel's left
             edge (transparent fill — a null background would not be
             hit-testable). The 1px stroke line is centred in it. -->
        <Border x:Name="GripBorder" Grid.Column="0"
                Background="Transparent"
                PointerPressed="Grip_PointerPressed"
                PointerMoved="Grip_PointerMoved"
                PointerReleased="Grip_PointerReleased"
                PointerCanceled="Grip_PointerReleased"
                DoubleTapped="Grip_DoubleTapped"
                ToolTipService.ToolTip="Resize panel"
                AutomationProperties.AutomationId="NowPlayingPanelGrip"
                AutomationProperties.Name="Resize panel">
            <Border Width="1" HorizontalAlignment="Center"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== FX host: an empty, input-transparent border
                 spanning the whole card; the Composition layer is
                 attached to it in code-behind (NowPlayingPanel.Fx.cs)
                 and renders BEHIND the header and body. No background
                 of its own — an unfilled border is not hit-testable,
                 so it never intercepts input. When the FX mode is
                 Off no visuals are attached and the tint borders
                 below paint exactly as before. ===== -->
            <Border x:Name="FxHost" Grid.Row="0" Grid.RowSpan="2" />

            <!-- ===== Header (always visible, even when idle):
                 label, sleep chip, close. ===== -->
            <Border x:Name="HeaderTintBorder" Grid.Row="0" Background="{ThemeResource HeroTintBrush}">
                <Grid Margin="24,12,12,6">
                    <!-- Header: label, sleep chip, close. -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PanelTitleText" Grid.Column="0"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   CharacterSpacing="80"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                VerticalAlignment="Center"
                                Padding="12,4"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind ViewModel.SleepTimerVisibility, Mode=OneWay}">
                            <TextBlock Text="Sleep timer on"
                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                        </Border>
                        <Button Grid.Column="2"
                                Width="36" Height="36" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Click="CloseButton_Click"
                                ToolTipService.ToolTip="Close"
                                AutomationProperties.AutomationId="NowPlayingPanelClose"
                                AutomationProperties.Name="Close">
                            <SymbolIcon Symbol="Cancel" Width="14" Height="14" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== Player content: everything below the header.
                 Direction A rows: identity (Auto) / failure (Auto) /
                 air (*) / controls (Auto). Collapsed wholesale when
                 nothing is current; the idle placeholder (same root
                 row) takes its place. -->
            <Grid x:Name="PlayerContent" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- ===== Identity zone: artwork, title ===== -->
            <Border x:Name="HeroTintBorder" Grid.Row="0" Background="{ThemeResource HeroTintBrush}">
                <Grid Margin="24,2,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Artwork: square, sized in code-behind from
                         the panel width (direction A rule). A real
                         Image element in a rounded Border — the
                         app's proven artwork shape (Detail/Home/LCD).
                         This surface used to paint through an
                         ImageBrush background, which never rendered
                         the fresh per-open BitmapImage: the
                         placeholder collapsed (source non-null) over
                         a brush that stayed empty, leaving a blank
                         tint zone (bug, Manish 2026-10-08). GlowHost
                         is the Pulse mode's artwork glow anchor: an
                         empty border oversized by a negative margin
                         so its Composition visual spills softly
                         around the artwork; inert in other modes. -->
                    <Grid x:Name="ArtworkHost" Grid.Row="0"
                          HorizontalAlignment="Center">
                        <Border x:Name="GlowHost" Margin="-30" />
                        <Border x:Name="ArtworkPlaceholder" CornerRadius="12"
                                Background="{ThemeResource LayerFillColorAltBrush}">
                            <SymbolIcon Symbol="MusicInfo" Width="40" Height="40"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="12">
                            <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
                        </Border>
                    </Grid>

                    <!-- Title + tappable byline + favourite. The
                         title is ONE line at Title size (28) — long
                         titles ellipsize instead of wrapping and
                         shoving the byline around (polish N3). The
                         heart is vertically centred on the title
                         block, not floated against line one. -->
                    <Grid Grid.Row="1" Margin="0,14,0,0" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}"
                                       Style="{ThemeResource TitleTextBlockStyle}"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel x:Name="BylinePanel" Orientation="Horizontal" />
                        </StackPanel>
                        <Button x:Name="FavoriteButton" Grid.Column="1"
                                Width="40" Height="40" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center"
                                Click="FavoriteButton_Click"
                                AutomationProperties.AutomationId="NowPlayingFavorite">
                            <FontIcon x:Name="FavoriteIcon" Glyph="&#xEB51;" FontSize="20" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== Failure surface (the page's InfoBar, verbatim).
                 Lives with the identity zone it describes, so the
                 bottom-anchored controls never jitter when it
                 appears (polish §3). ===== -->
            <InfoBar Grid.Row="1" Margin="24,8,24,0"
                     Title="Playback problem"
                     Severity="Warning"
                     IsOpen="{x:Bind ViewModel.HasPlaybackError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.PlaybackError, Mode=OneWay}"
                     Closed="FailureBar_Closed"
                     AutomationProperties.AutomationId="NowPlayingFailure">
                <InfoBar.ActionButton>
                    <Button Content="Next track"
                            Click="FailureNext_Click"
                            AutomationProperties.AutomationId="NowPlayingFailureNext"
                            AutomationProperties.Name="Next track" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- ===== Controls zone: pinned to the panel's bottom
                 edge by the * row above it. Times sit ABOVE the
                 slider (direction A reading order); transport and
                 menus follow at the samples' tightened rhythm. -->
            <StackPanel Grid.Row="3" Margin="24,0,24,18">
                <!-- Seek times: tabular numerals so the layout never
                     jitters; the slider below is driven from
                     code-behind with the page's drag guard. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ViewModel.PositionText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Typography.NumeralAlignment="Tabular" />
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind ViewModel.DurationText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Typography.NumeralAlignment="Tabular" />
                </Grid>
                <Slider x:Name="SeekSlider"
                        Minimum="0"
                        Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                        StepFrequency="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="NowPlayingSeek"
                        AutomationProperties.Name="Seek"
                        PointerPressed="SeekSlider_PointerPressed"
                        PointerReleased="SeekSlider_PointerReleased"
                        ValueChanged="SeekSlider_ValueChanged" />

                <!-- Transport: bare glyphs (Manish, 2026-10-08).
                     Shuffle/repeat on-state = accent glyph + state
                     dot, painted in RefreshFromViewModel; only
                     play/pause keeps the filled accent disc (the
                     shared primary style). -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0"
                            HorizontalAlignment="Center">
                    <ToggleButton x:Name="ShuffleButton"
                                  Style="{StaticResource PanelTransportToggleStyle}"
                                  IsChecked="{x:Bind ViewModel.IsShuffle, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Shuffle"
                                  AutomationProperties.AutomationId="NowPlayingShuffle"
                                  AutomationProperties.Name="Shuffle off">
                        <Grid>
                            <SymbolIcon x:Name="ShuffleIcon" Symbol="Shuffle" Width="20" Height="20" />
                            <Ellipse x:Name="ShuffleStateDot" Width="4" Height="4"
                                     HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                     Margin="0,0,0,6" Visibility="Collapsed"
                                     Fill="{ThemeResource TransportActiveBrush}" />
                        </Grid>
                    </ToggleButton>
                    <Button Style="{StaticResource PanelTransportButtonStyle}"
                            Command="{x:Bind ViewModel.PreviousTrackCommand}"
                            ToolTipService.ToolTip="Previous"
                            AutomationProperties.AutomationId="NowPlayingPrevious"
                            AutomationProperties.Name="Previous track">
                        <SymbolIcon Symbol="Previous" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource TransportPrimaryButtonStyle}"
                            Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                            ToolTipService.ToolTip="Play or pause"
                            AutomationProperties.AutomationId="NowPlayingPanelPlayPause"
                            AutomationProperties.Name="Play or pause">
                        <SymbolIcon Symbol="{x:Bind ViewModel.PlayPauseSymbol, Mode=OneWay}" Width="24" Height="24" />
                    </Button>
                    <Button Style="{StaticResource PanelTransportButtonStyle}"
                            Command="{x:Bind ViewModel.NextTrackCommand}"
                            ToolTipService.ToolTip="Next"
                            AutomationProperties.AutomationId="NowPlayingNext"
                            AutomationProperties.Name="Next track">
                        <SymbolIcon Symbol="Next" Width="20" Height="20" />
                    </Button>
                    <Button x:Name="RepeatButton"
                            Style="{StaticResource PanelTransportButtonStyle}"
                            Click="RepeatButton_Click"
                            AutomationProperties.AutomationId="NowPlayingRepeat"
                            AutomationProperties.Name="Repeat">
                        <Grid>
                            <SymbolIcon x:Name="RepeatIcon" Symbol="RepeatAll" Width="20" Height="20" />
                            <Ellipse x:Name="RepeatStateDot" Width="4" Height="4"
                                     HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                     Margin="0,0,0,6" Visibility="Collapsed"
                                     Fill="{ThemeResource TransportActiveBrush}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Secondary: playback speed + sleep timer. The
                     fill drops to the subtler secondary control
                     fill so the menus stop outweighing the bare
                     transport glyphs beside them (polish N6). -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"
                            HorizontalAlignment="Center">
                    <DropDownButton Content="Speed"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderThickness="0"
                                    AutomationProperties.AutomationId="NowPlayingSpeed"
                                    AutomationProperties.Name="Playback speed">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <RadioMenuFlyoutItem Text="0.5×" Tag="0.5" GroupName="PlaybackSpeed"
                                                     Click="SpeedItem_Click"
                                                     AutomationProperties.AutomationId="Speed0_5" />
                                <RadioMenuFlyoutItem Text="0.75×" Tag="0.75" GroupName="PlaybackSpeed"
                                                     Click="SpeedItem_Click"
                                                     AutomationProperties.AutomationId="Speed0_75" />
                                <RadioMenuFlyoutItem Text="1.0×" Tag="1" GroupName="PlaybackSpeed" IsChecked="True"
                                                     Click="SpeedItem_Click"
                                                     AutomationProperties.AutomationId="Speed1_0" />
                                <RadioMenuFlyoutItem Text="1.25×" Tag="1.25" GroupName="PlaybackSpeed"
                                                     Click="SpeedItem_Click"
                                                     AutomationProperties.AutomationId="Speed1_25" />
                                <RadioMenuFlyoutItem Text="1.5×" Tag="1.5" GroupName="PlaybackSpeed"
                                                     Click="SpeedItem_Click"
                                                     AutomationProperties.AutomationId="Speed1_5" />
                                <RadioMenuFlyoutItem Text="2.0×" Tag="2" GroupName="PlaybackSpeed"
                                                     Click="SpeedItem_Click"
                                                     AutomationProperties.AutomationId="Speed2_0" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton Content="Sleep timer"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderThickness="0"
                                    AutomationProperties.AutomationId="NowPlayingSleepTimer"
                                    AutomationProperties.Name="Sleep timer">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Off" Tag="0"
                                                Click="SleepItem_Click"
                                                AutomationProperties.AutomationId="SleepOff" />
                                <MenuFlyoutItem Text="5 minutes" Tag="5"
                                                Click="SleepItem_Click"
                                                AutomationProperties.AutomationId="Sleep5" />
                                <MenuFlyoutItem Text="15 minutes" Tag="15"
                                                Click="SleepItem_Click"
                                                AutomationProperties.AutomationId="Sleep15" />
                                <MenuFlyoutItem Text="30 minutes" Tag="30"
                                                Click="SleepItem_Click"
                                                AutomationProperties.AutomationId="Sleep30" />
                                <MenuFlyoutItem Text="45 minutes" Tag="45"
                                                Click="SleepItem_Click"
                                                AutomationProperties.AutomationId="Sleep45" />
                                <MenuFlyoutItem Text="60 minutes" Tag="60"
                                                Click="SleepItem_Click"
                                                AutomationProperties.AutomationId="Sleep60" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </StackPanel>

            </Grid>

            <!-- ===== Idle state: nothing current. One composed
                 empty state replaces the whole player body (the
                 header above stays — it carries the close button).
                 Shown/hidden from RefreshFromViewModel, the panel's
                 single sync point. ===== -->
            <ContentControl x:Name="IdlePlaceholder" Grid.Row="1"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Visibility="Collapsed"
                              AutomationProperties.AutomationId="NowPlayingIdlePlaceholder">
                <StackPanel Style="{StaticResource EmptyStatePanelStyle}"
                            VerticalAlignment="Center">
                    <Border Width="76" Height="76" CornerRadius="38"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource HeroTintBrush}">
                        <SymbolIcon Symbol="MusicInfo" Width="34" Height="34"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <TextBlock x:Name="IdleTitleText"
                               Style="{StaticResource EmptyStateHeadlineStyle}" />
                    <TextBlock x:Name="IdleBodyText"
                               Style="{StaticResource EmptyStateGuidanceStyle}" />
                </StackPanel>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
