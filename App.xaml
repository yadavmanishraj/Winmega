<Application
    x:Class="Omega.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Omega.Converters"
    xmlns:vm="using:Omega.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Converters for page state surfaces (loading / empty /
                 error visibility), shared by all pages. -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#3BE477</Color>
                    <Color x:Key="SystemAccentColorLight1">#65E995</Color>
                    <Color x:Key="SystemAccentColorLight2">#8FF0B0</Color>
                    <Color x:Key="SystemAccentColorLight3">#C4F9D8</Color>
                    <Color x:Key="SystemAccentColorDark1">#2FBC5E</Color>
                    <Color x:Key="SystemAccentColorDark2">#249A4B</Color>
                    <Color x:Key="SystemAccentColorDark3">#1B7539</Color>
                    <!-- Purpose-named brushes (never named by hue). -->
                    <SolidColorBrush x:Key="HeroSurfaceBrush" Color="#12122B" />
                    <SolidColorBrush x:Key="HeroTintBrush" Color="#1E1B4B" />
                    <!-- Transport on-state glyph (shuffle/repeat in the
                         shell strip): the accent itself, spent on state
                         only (APPLE_LAYOUT_SPEC §0/§3.3). -->
                    <SolidColorBrush x:Key="TransportActiveBrush" Color="#3BE477" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#2DBE62</Color>
                    <Color x:Key="SystemAccentColorLight1">#3BE477</Color>
                    <Color x:Key="SystemAccentColorLight2">#7FECA6</Color>
                    <Color x:Key="SystemAccentColorLight3">#C4F9D8</Color>
                    <Color x:Key="SystemAccentColorDark1">#1FA855</Color>
                    <Color x:Key="SystemAccentColorDark2">#178541</Color>
                    <Color x:Key="SystemAccentColorDark3">#106332</Color>
                    <SolidColorBrush x:Key="HeroSurfaceBrush" Color="#ECECF7" />
                    <SolidColorBrush x:Key="HeroTintBrush" Color="#D9D4F5" />
                    <SolidColorBrush x:Key="TransportActiveBrush" Color="#2DBE62" />
                </ResourceDictionary>
                <!-- HighContrast: intentionally empty for now (design
                     §10) — the platform's SystemColor* brushes already
                     carry the built-in controls, and the custom brushes
                     above fall back to the active Light/Dark values. If
                     HC-specific overrides are ever added here, they must
                     be SystemColor*Brush resources only, no opacity. -->
                <ResourceDictionary x:Key="HighContrast" />
            </ResourceDictionary.ThemeDictionaries>

            <!-- ============ Shared design system (AUDIT_2 §8) ========
                 One definition per component, consumed by every page.
                 Radius intent is named once here (Card = 8, Hero = 16);
                 pages never restyle these components inline. -->
            <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="HeroCornerRadius">16</CornerRadius>

            <!-- Secondary text: the platform secondary brush (theme- and
                 High-Contrast-aware). Replaces every Opacity-dimmed
                 TextBlock (AUDIT_2 V-17/A-1) — opacity washes text out
                 in HC and compounds over tinted surfaces. -->
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SecondaryCaptionStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Page-level type roles, so the same semantic role is the
                 same style on every page (AUDIT_2 §0 table). -->
            <Style x:Key="PageTitleStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource TitleTextBlockStyle}" />
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource SubtitleTextBlockStyle}" />

            <!-- The one icon-button spec (AUDIT_2 V-18): 44px target,
                 transparent rest, platform hover/pressed fills. -->
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Card surfaces (Settings cards; AUDIT_2 §8.6). -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <!-- Hero surfaces (Home / Detail headers): the hero brush at
                 the hero radius with the tightened 20px inset (V-07). -->
            <Style x:Key="HeroCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource HeroSurfaceBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource HeroCornerRadius}" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!-- One transport language (AUDIT_2 V-02/V-03): filled discs
                 everywhere transport appears — strip (shell) and the
                 Now Playing page share these, so state reads by shape
                 (disc + accent) and not by colour alone (A-4). -->
            <Style x:Key="TransportButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="24" />
            </Style>
            <Style x:Key="TransportToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="24" />
            </Style>
            <Style x:Key="TransportPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="64" />
                <Setter Property="Height" Value="64" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="32" />
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>

            <!-- Song-row containers sit flush with their section headers
                 (AUDIT_2 V-08): the template carries the only inset. -->
            <Style x:Key="RowItemContainerStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <!-- Empty-state composition (AUDIT_2 V-12): centred icon,
                 headline, one-line guidance, optional action. Replaces
                 the bare grey text lines every empty surface used. -->
            <Style x:Key="EmptyStatePanelStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,32,0,32" />
            </Style>
            <Style x:Key="EmptyStateHeadlineStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
            <Style x:Key="EmptyStateGuidanceStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- ============ THE shared song row (AUDIT_2 §8.1) ========
                 One template for every song list in the app (Home,
                 Search, Library, Detail) — the four page-local copies
                 had already diverged (Library's had Remove, Detail's
                 did not) and the pattern failed under real pointer
                 input (POINTER_QA F4: the inline Button.Flyout inside
                 the recycled template never materialised and the click
                 landed on the adjacent favourite toggle). Structural
                 rules here: favourite and More are sibling buttons on
                 their own Auto columns (44px each, 12px spacing, no
                 shared cell, no overlap); the SAME MenuFlyout content
                 is offered as the row's ContextFlyout so right-click
                 works too; Play is also on the artwork (hover disc),
                 so the menu is never the only route to play. -->
            <DataTemplate x:Key="SongRowTemplate" x:DataType="vm:SongItemViewModel">
                <Grid ColumnSpacing="12" Padding="4,4" MinHeight="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="PlayMenuItem" Command="{x:Bind PlayCommand}"
                                            AutomationProperties.AutomationId="SongPlayMenuItem" />
                            <MenuFlyoutItem x:Uid="PlayNextMenuItem" Command="{x:Bind PlayNextCommand}"
                                            Visibility="{x:Bind CanPlayNext, Converter={StaticResource BoolToVisibilityConverter}}"
                                            AutomationProperties.AutomationId="SongPlayNextMenuItem" />
                            <MenuFlyoutItem x:Uid="AddToQueueMenuItem" Command="{x:Bind AddToQueueCommand}"
                                            Visibility="{x:Bind CanAddToQueue, Converter={StaticResource BoolToVisibilityConverter}}"
                                            AutomationProperties.AutomationId="SongAddToQueueMenuItem" />
                            <MenuFlyoutItem Text="{x:Bind FavoriteMenuText, Mode=OneWay}"
                                            Command="{x:Bind ToggleFavoriteCommand}"
                                            AutomationProperties.AutomationId="SongFavoriteMenuItem" />
                            <MenuFlyoutItem x:Uid="AddToPlaylistMenuItem" Command="{x:Bind AddToPlaylistCommand}"
                                            IsEnabled="{x:Bind CanAddToPlaylist}"
                                            AutomationProperties.AutomationId="SongAddToPlaylistMenuItem" />
                            <MenuFlyoutItem x:Uid="DownloadMenuItem" Command="{x:Bind DownloadCommand}"
                                            Visibility="{x:Bind CanDownload, Converter={StaticResource BoolToVisibilityConverter}}"
                                            AutomationProperties.AutomationId="SongDownloadMenuItem" />
                            <MenuFlyoutItem Text="{x:Bind RemoveMenuText}"
                                            Command="{x:Bind RemoveCommand}"
                                            Visibility="{x:Bind CanRemove, Converter={StaticResource BoolToVisibilityConverter}}"
                                            AutomationProperties.AutomationId="SongRemoveMenuItem" />
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                    <Grid Width="48" Height="48">
                        <Image Source="{x:Bind Artwork}" Width="48" Height="48" Stretch="UniformToFill"
                               AutomationProperties.AccessibilityView="Raw" />
                        <Button Width="28" Height="28" Padding="0" CornerRadius="14"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderThickness="0"
                                Command="{x:Bind PlayCommand}"
                                AutomationProperties.AutomationId="SongArtworkPlayButton"
                                AutomationProperties.Name="Play">
                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                        </Button>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Artists}" Style="{StaticResource SecondaryCaptionStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind DurationText}"
                               Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                            Command="{x:Bind ToggleFavoriteCommand}"
                            AutomationProperties.AutomationId="SongFavoriteButton"
                            AutomationProperties.Name="{x:Bind FavoriteMenuText, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" FontSize="18" />
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.AutomationId="SongMoreButton"
                            AutomationProperties.Name="{x:Bind MoreActionsName}">
                        <FontIcon Glyph="&#xE712;" FontSize="18" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="PlayMenuItem" Command="{x:Bind PlayCommand}"
                                                AutomationProperties.AutomationId="SongPlayMenuItem" />
                                <MenuFlyoutItem x:Uid="PlayNextMenuItem" Command="{x:Bind PlayNextCommand}"
                                                Visibility="{x:Bind CanPlayNext, Converter={StaticResource BoolToVisibilityConverter}}"
                                                AutomationProperties.AutomationId="SongPlayNextMenuItem" />
                                <MenuFlyoutItem x:Uid="AddToQueueMenuItem" Command="{x:Bind AddToQueueCommand}"
                                                Visibility="{x:Bind CanAddToQueue, Converter={StaticResource BoolToVisibilityConverter}}"
                                                AutomationProperties.AutomationId="SongAddToQueueMenuItem" />
                                <MenuFlyoutItem Text="{x:Bind FavoriteMenuText, Mode=OneWay}"
                                                Command="{x:Bind ToggleFavoriteCommand}"
                                                AutomationProperties.AutomationId="SongFavoriteMenuItem" />
                                <MenuFlyoutItem x:Uid="AddToPlaylistMenuItem" Command="{x:Bind AddToPlaylistCommand}"
                                                IsEnabled="{x:Bind CanAddToPlaylist}"
                                                AutomationProperties.AutomationId="SongAddToPlaylistMenuItem" />
                                <MenuFlyoutItem x:Uid="DownloadMenuItem" Command="{x:Bind DownloadCommand}"
                                                Visibility="{x:Bind CanDownload, Converter={StaticResource BoolToVisibilityConverter}}"
                                                AutomationProperties.AutomationId="SongDownloadMenuItem" />
                                <MenuFlyoutItem Text="{x:Bind RemoveMenuText}"
                                                Command="{x:Bind RemoveCommand}"
                                                Visibility="{x:Bind CanRemove, Converter={StaticResource BoolToVisibilityConverter}}"
                                                AutomationProperties.AutomationId="SongRemoveMenuItem" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </DataTemplate>

            <!-- Theming (design §10): explicit Light / Dark / HighContrast
                 dictionaries — never "Default". Usage sites bind with
                 {ThemeResource} so theme switches live-update. The play-
                 green accent (#3BE477 family) overrides SystemAccentColor
                 app-wide — the on-pattern way first-party apps
                 differentiate — while Mica supplies the window backdrop.
                 HighContrast contains ONLY SystemColor* resources. -->

            <!-- Strip transport (shell): the 40px disc language the
                 Now Playing page speaks at 48px (AUDIT_2 V-02/03). -->
        <Style x:Key="StripTransportButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StripTransportToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
