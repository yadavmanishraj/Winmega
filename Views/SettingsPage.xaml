<Page
    x:Class="Omega.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Settings (design §9.6): grouped card rows, persisted
         immediately. Cards use the shared CardStyle (App.xaml);
         theme switch applies to the root element via
         App.ApplyThemeMode. Column rule (AUDIT_2 V-15): forms are
         left-aligned at 760 — the player centres, feeds run
         full-bleed. -->
    <ScrollViewer>
        <StackPanel Padding="24,24,24,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock x:Uid="SettingsTitle" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="SettingsSubtitle" Style="{StaticResource SecondaryTextStyle}" />

            <!-- Appearance -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="AppearanceHeader" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="ThemeLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <RadioButtons ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                  SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="SettingsThemeRadios" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="48" Height="48" CornerRadius="8"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Uid="AccentSwatchLabel"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Playback -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="PlaybackHeader" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="QualityLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.QualityOptions}"
                              SelectedIndex="{x:Bind ViewModel.SelectedQualityIndex, Mode=TwoWay}"
                              MinWidth="280" HorizontalAlignment="Left"
                              AutomationProperties.AutomationId="SettingsQualityCombo" />
                    <TextBlock x:Uid="QualityNote" Style="{StaticResource SecondaryCaptionStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock x:Uid="SettingsEndpointNote"
                       Style="{StaticResource SecondaryCaptionStyle}"
                       TextWrapping="Wrap" />

            <!-- About -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="AboutHeader" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.AppName}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="VersionLabel" Style="{ThemeResource BodyTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.VersionText}"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   AutomationProperties.AutomationId="SettingsVersion" />
                    </StackPanel>
                    <TextBlock x:Uid="AboutBody" Style="{ThemeResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
