<Page
    x:Class="Omega.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Omega.ViewModels"
    xmlns:controls="using:Omega.Controls">

    <!-- Search (design §9.3 + Manish, 2026-10-08): the app's one
         search box lives at the top of THIS page (the sidebar
         carries a plain Search section row); a query can also still
         arrive as a navigation parameter. SelectorBar tabs (Top
         results / Songs / Albums / Artists / Playlists). Each tab
         keeps its own collection in the ViewModel; the page only
         switches panel visibility. Song rows are the shared SongRow
         control (Controls/SongRow.xaml). No page subtitle
         (AUDIT_2 V-10): the title + the idle hint said the same
         sentence three times. -->
    <Page.Resources>
        <DataTemplate x:Key="TopResultRowTemplate" x:DataType="vm:SearchResultItemViewModel">
            <Grid ColumnSpacing="12" Padding="4,4" MinHeight="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{x:Bind Artwork}" Width="48" Height="48" Stretch="UniformToFill"
                       AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryCaptionStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                        Command="{x:Bind PlayCommand}"
                        Visibility="{x:Bind IsSong, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="TopResultPlayButton"
                        AutomationProperties.Name="{x:Bind PlayName}">
                    <FontIcon Glyph="&#xE768;" FontSize="18" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TileTemplate" x:DataType="vm:TileItemViewModel">
            <StackPanel Width="136" Spacing="6">
                <Image Source="{x:Bind Artwork}" Width="136" Height="136" Stretch="UniformToFill"
                       AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryCaptionStyle}"
                           TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TileRowTemplate" x:DataType="vm:TileItemViewModel">
            <Grid ColumnSpacing="12" Padding="4,4" MinHeight="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{x:Bind Artwork}" Width="48" Height="48" Stretch="UniformToFill"
                       AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryCaptionStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- Song rows: the shared SongRow control, fed the item by a
             page-local template (page-local DataTemplates with x:Bind
             are codegen-proven here; the merged-dictionary template
             this replaces never evaluated its bindings — D1). -->
        <DataTemplate x:Key="SongRowItemTemplate" x:DataType="vm:SongItemViewModel">
            <controls:SongRow ViewModel="{x:Bind}" />
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24,24,24,24" Spacing="16">
            <TextBlock x:Uid="SearchTitle" Style="{StaticResource PageTitleStyle}" />

            <!-- The SearchBox id lives exactly once, here.
                 Submit-only: typing never searches (the behaviour
                 the sidebar box had); the box takes keyboard focus
                 when the page is navigated to. -->
            <AutoSuggestBox x:Name="SearchBox"
                            x:Uid="SearchBox"
                            QueryIcon="Find"
                            MaxWidth="560"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="SearchBox"
                            QuerySubmitted="SearchBox_QuerySubmitted" />

            <SelectorBar x:Name="SearchTabs"
                         AutomationProperties.AutomationId="SearchTabs"
                         SelectionChanged="SearchTabs_SelectionChanged">
                <SelectorBarItem x:Name="TabTop" x:Uid="SearchTabTop" IsSelected="True"
                                 AutomationProperties.AutomationId="SearchTabTop" />
                <SelectorBarItem x:Name="TabSongs" x:Uid="SearchTabSongs"
                                 AutomationProperties.AutomationId="SearchTabSongs" />
                <SelectorBarItem x:Name="TabAlbums" x:Uid="SearchTabAlbums"
                                 AutomationProperties.AutomationId="SearchTabAlbums" />
                <SelectorBarItem x:Name="TabArtists" x:Uid="SearchTabArtists"
                                 AutomationProperties.AutomationId="SearchTabArtists" />
                <SelectorBarItem x:Name="TabPlaylists" x:Uid="SearchTabPlaylists"
                                 AutomationProperties.AutomationId="SearchTabPlaylists" />
            </SelectorBar>

            <!-- States: centred loading (V-19), non-dismissable error
                 bar (V-20), composed idle / no-results states (V-12). -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,48,0,0"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="32" Height="32" />
                <TextBlock x:Uid="LoadingText" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Error"
                     x:Uid="ErrorInfoBar"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     AutomationProperties.AutomationId="SearchError">
                <InfoBar.ActionButton>
                    <Button x:Uid="RetryButton" Command="{x:Bind ViewModel.RetrySearchCommand}"
                            AutomationProperties.AutomationId="SearchRetry" />
                </InfoBar.ActionButton>
            </InfoBar>
            <StackPanel Style="{StaticResource EmptyStatePanelStyle}"
                        Visibility="{x:Bind ViewModel.ShowIdle, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE721;" FontSize="40" HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Uid="SearchStartHint" Style="{StaticResource EmptyStateGuidanceStyle}" />
            </StackPanel>
            <StackPanel Style="{StaticResource EmptyStatePanelStyle}"
                        Visibility="{x:Bind ViewModel.ShowNoResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE721;" FontSize="40" HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="{x:Bind ViewModel.NoResultsText, Mode=OneWay}"
                           Style="{StaticResource EmptyStateGuidanceStyle}"
                           AutomationProperties.AutomationId="SearchNoResults" />
            </StackPanel>

            <!-- Top results -->
            <StackPanel x:Name="TopPanel" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Visibility="{x:Bind ViewModel.TopLoadFailed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock x:Uid="SearchSectionFailed" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
                    <Button x:Uid="RetryButton" Command="{x:Bind ViewModel.RetrySearchCommand}"
                            AutomationProperties.AutomationId="SearchSectionRetryTop" />
                </StackPanel>
                <!-- FilteredTopResults is the page's own mirror of
                     ViewModel.TopResults minus DisplayOnly rows
                     (SearchPage.xaml.cs) — the Top tab never renders
                     an inert row. -->
                <ListView ItemsSource="{x:Bind FilteredTopResults, Mode=OneWay}"
                          ItemTemplate="{StaticResource TopResultRowTemplate}"
                          ItemContainerStyle="{StaticResource RowItemContainerStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="TopResults_ItemClick"
                          AutomationProperties.AutomationId="SearchTopResults" />
            </StackPanel>

            <!-- Songs -->
            <StackPanel x:Name="SongsPanel" Spacing="8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Visibility="{x:Bind ViewModel.SongsLoadFailed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock x:Uid="SearchSectionFailed" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
                    <Button x:Uid="RetryButton" Command="{x:Bind ViewModel.RetrySearchCommand}"
                            AutomationProperties.AutomationId="SearchSectionRetrySongs" />
                </StackPanel>
                <ListView ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                          ItemTemplate="{StaticResource SongRowItemTemplate}"
                          ItemContainerStyle="{StaticResource RowItemContainerStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="SongRow_ItemClick"
                          AutomationProperties.AutomationId="SearchSongsList" />
                <Button x:Uid="LoadMoreButton" Command="{x:Bind ViewModel.LoadMoreSongsCommand}"
                        MinHeight="44" HorizontalAlignment="Left"
                        Visibility="{x:Bind ViewModel.HasMoreSongs, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="SearchLoadMoreSongs" />
            </StackPanel>

            <!-- Albums -->
            <StackPanel x:Name="AlbumsPanel" Spacing="8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Visibility="{x:Bind ViewModel.AlbumsLoadFailed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock x:Uid="SearchSectionFailed" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
                    <Button x:Uid="RetryButton" Command="{x:Bind ViewModel.RetrySearchCommand}"
                            AutomationProperties.AutomationId="SearchSectionRetryAlbums" />
                </StackPanel>
                <GridView ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                          ItemTemplate="{StaticResource TileTemplate}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Tile_ItemClick"
                          AutomationProperties.AutomationId="SearchAlbumsGrid" />
                <Button x:Uid="LoadMoreButton" Command="{x:Bind ViewModel.LoadMoreAlbumsCommand}"
                        MinHeight="44" HorizontalAlignment="Left"
                        Visibility="{x:Bind ViewModel.HasMoreAlbums, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="SearchLoadMoreAlbums" />
            </StackPanel>

            <!-- Artists -->
            <StackPanel x:Name="ArtistsPanel" Spacing="8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Visibility="{x:Bind ViewModel.ArtistsLoadFailed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock x:Uid="SearchSectionFailed" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
                    <Button x:Uid="RetryButton" Command="{x:Bind ViewModel.RetrySearchCommand}"
                            AutomationProperties.AutomationId="SearchSectionRetryArtists" />
                </StackPanel>
                <ListView ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}"
                          ItemTemplate="{StaticResource TileRowTemplate}"
                          ItemContainerStyle="{StaticResource RowItemContainerStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Tile_ItemClick"
                          AutomationProperties.AutomationId="SearchArtistsList" />
                <Button x:Uid="LoadMoreButton" Command="{x:Bind ViewModel.LoadMoreArtistsCommand}"
                        MinHeight="44" HorizontalAlignment="Left"
                        Visibility="{x:Bind ViewModel.HasMoreArtists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="SearchLoadMoreArtists" />
            </StackPanel>

            <!-- Playlists -->
            <StackPanel x:Name="PlaylistsPanel" Spacing="8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Visibility="{x:Bind ViewModel.PlaylistsLoadFailed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock x:Uid="SearchSectionFailed" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
                    <Button x:Uid="RetryButton" Command="{x:Bind ViewModel.RetrySearchCommand}"
                            AutomationProperties.AutomationId="SearchSectionRetryPlaylists" />
                </StackPanel>
                <GridView ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                          ItemTemplate="{StaticResource TileTemplate}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Tile_ItemClick"
                          AutomationProperties.AutomationId="SearchPlaylistsGrid" />
                <Button x:Uid="LoadMoreButton" Command="{x:Bind ViewModel.LoadMorePlaylistsCommand}"
                        MinHeight="44" HorizontalAlignment="Left"
                        Visibility="{x:Bind ViewModel.HasMorePlaylists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="SearchLoadMorePlaylists" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
