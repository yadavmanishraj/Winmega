<Page
    x:Class="Omega.Views.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Omega.ViewModels">

    <!-- Detail (design §9.5): one page for Album / Playlist / Artist,
         chosen by the DetailNavigationArgs kind. Hero artwork +
         metadata + Play All, then the track list; artist pages add
         bio / top albums / singles / similar artists sections. The
         song-row template is the shared one in App.xaml; the header
         uses the shared hero card treatment (AUDIT_2 V-16). -->
    <Page.Resources>
        <DataTemplate x:Key="TileTemplate" x:DataType="vm:TileItemViewModel">
            <StackPanel Width="136" Spacing="6">
                <Image Source="{x:Bind Artwork}" Width="136" Height="136" Stretch="UniformToFill"
                       AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryCaptionStyle}"
                           TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TileRowTemplate" x:DataType="vm:TileItemViewModel">
            <Grid ColumnSpacing="12" Padding="4,4" MinHeight="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{x:Bind Artwork}" Width="48" Height="48" Stretch="UniformToFill"
                       AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryCaptionStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24,24,24,24" Spacing="16">
            <Button Click="Back_Click" MinHeight="44" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="DetailBack">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Back" />
                    <TextBlock x:Uid="BackLabel" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Header -->
            <Border Style="{StaticResource HeroCardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{x:Bind ViewModel.HeaderArtwork, Mode=OneWay}"
                           Width="144" Height="144" Stretch="UniformToFill"
                           AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.MetaText, Mode=OneWay}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap" />
                        <Button x:Uid="PlayAllButton"
                                Command="{x:Bind ViewModel.PlayAllCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                MinWidth="48" MinHeight="48" Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Visibility="{x:Bind ViewModel.HasSongs, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.AutomationId="DetailPlayAll" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Loading / error -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,48,0,0"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="32" Height="32" />
                <TextBlock x:Uid="LoadingText" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Error"
                     x:Uid="ErrorInfoBar"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     AutomationProperties.AutomationId="DetailError">
                <InfoBar.ActionButton>
                    <Button x:Uid="RetryButton" Command="{x:Bind ViewModel.RetryCommand}"
                            AutomationProperties.AutomationId="DetailRetry" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Bio (artists) -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.HasBio, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock x:Uid="BioHeader" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="{x:Bind ViewModel.BioText, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" MaxWidth="760"
                           HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Songs / top songs -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.HasSongs, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock x:Name="SongsHeader" Style="{StaticResource SectionHeaderStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                          ItemTemplate="{StaticResource SongRowTemplate}"
                          ItemContainerStyle="{StaticResource RowItemContainerStyle}"
                          SelectionMode="None"
                          AutomationProperties.AutomationId="DetailSongsList" />
                <Button x:Uid="LoadMoreButton" Command="{x:Bind ViewModel.LoadMoreSongsCommand}"
                        MinHeight="44" HorizontalAlignment="Left"
                        Visibility="{x:Bind ViewModel.HasMoreSongs, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="DetailLoadMoreSongs" />
            </StackPanel>

            <!-- Singles (artists) -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.HasSingles, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock x:Uid="SinglesHeader" Style="{StaticResource SectionHeaderStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.Singles, Mode=OneWay}"
                          ItemTemplate="{StaticResource SongRowTemplate}"
                          ItemContainerStyle="{StaticResource RowItemContainerStyle}"
                          SelectionMode="None"
                          AutomationProperties.AutomationId="DetailSinglesList" />
            </StackPanel>

            <!-- Top albums (artists) -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.HasTopAlbums, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock x:Uid="TopAlbumsHeader" Style="{StaticResource SectionHeaderStyle}" />
                <GridView ItemsSource="{x:Bind ViewModel.TopAlbums, Mode=OneWay}"
                          ItemTemplate="{StaticResource TileTemplate}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Tile_ItemClick"
                          AutomationProperties.AutomationId="DetailTopAlbumsGrid" />
            </StackPanel>

            <!-- Similar artists -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.HasSimilarArtists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock x:Uid="SimilarArtistsHeader" Style="{StaticResource SectionHeaderStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.SimilarArtists, Mode=OneWay}"
                          ItemTemplate="{StaticResource TileRowTemplate}"
                          ItemContainerStyle="{StaticResource RowItemContainerStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Tile_ItemClick"
                          AutomationProperties.AutomationId="DetailSimilarArtistsList" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
