<Page
    x:Class="Omega.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Omega.ViewModels"
    xmlns:controls="using:Omega.Controls">

    <!-- Library (design §9.4): all-local. SelectorBar sections
         Favorites / Playlists / Artists / Albums / Songs / History /
         Downloads, each with a count line and its own empty state.
         Artists/Albums/Songs aggregate the local library union
         (FX3); group tiles open Detail when they carry an upstream
         id, otherwise they filter the Songs tab. Song rows are
         the shared SongRow control (Controls/SongRow.xaml); empty states use
         the shared EmptyState composition (AUDIT_2 V-12). -->
    <Page.Resources>
        <DataTemplate x:Key="PlaylistRowTemplate" x:DataType="vm:PlaylistItemViewModel">
            <StackPanel Spacing="2" Padding="4,6">
                <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind SongCountText}" Style="{StaticResource SecondaryCaptionStyle}" />
                <TextBlock Text="{x:Bind UpdatedText}" Style="{StaticResource SecondaryCaptionStyle}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GroupTileTemplate" x:DataType="vm:LibraryGroupItemViewModel">
            <StackPanel Width="136" Spacing="6">
                <Image Source="{x:Bind Artwork}" Width="136" Height="136" Stretch="UniformToFill"
                       AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryCaptionStyle}"
                           TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DownloadRowTemplate" x:DataType="vm:DownloadItemViewModel">
            <Grid ColumnSpacing="12" Padding="4,4" MinHeight="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{x:Bind Artwork}" Width="48" Height="48" Stretch="UniformToFill"
                       AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Artists}" Style="{StaticResource SecondaryCaptionStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource SecondaryCaptionStyle}" />
                    <ProgressBar Value="{x:Bind ProgressValue}" Maximum="100" Width="200"
                                 HorizontalAlignment="Left"
                                 Visibility="{x:Bind IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{x:Bind ProgressText}" Style="{ThemeResource CaptionTextBlockStyle}"
                               Visibility="{x:Bind IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{x:Bind ErrorText}" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind HasErrorText, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                        Command="{x:Bind DeleteCommand}"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="DownloadDeleteButton"
                        AutomationProperties.Name="{x:Bind DeleteName}">
                    <FontIcon Glyph="&#xE74D;" FontSize="18" />
                </Button>
            </Grid>
        </DataTemplate>
        <!-- Song rows: the shared SongRow control, fed the item by a
             page-local template (page-local DataTemplates with x:Bind
             are codegen-proven here; the merged-dictionary template
             this replaces never evaluated its bindings — D1). -->
        <DataTemplate x:Key="SongRowItemTemplate" x:DataType="vm:SongItemViewModel">
            <controls:SongRow ViewModel="{x:Bind}" />
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24,24,24,24" Spacing="16">
            <TextBlock x:Uid="LibraryTitle" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="LibrarySubtitle" Style="{StaticResource SecondaryTextStyle}" />

            <!-- Seven tabs: the SelectorBar scrolls horizontally when
                 the window is too narrow for all of them. -->
            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <SelectorBar x:Name="LibraryTabs"
                             AutomationProperties.AutomationId="LibraryTabs"
                             SelectionChanged="LibraryTabs_SelectionChanged">
                    <SelectorBarItem x:Name="TabFavorites" x:Uid="LibraryTabFavorites" IsSelected="True"
                                     AutomationProperties.AutomationId="LibraryTabFavorites" />
                    <SelectorBarItem x:Name="TabPlaylists" x:Uid="LibraryTabPlaylists"
                                     AutomationProperties.AutomationId="LibraryTabPlaylists" />
                    <SelectorBarItem x:Name="TabArtists" x:Uid="LibraryTabArtists"
                                     AutomationProperties.AutomationId="LibraryTabArtists" />
                    <SelectorBarItem x:Name="TabAlbums" x:Uid="LibraryTabAlbums"
                                     AutomationProperties.AutomationId="LibraryTabAlbums" />
                    <SelectorBarItem x:Name="TabSongs" x:Uid="LibraryTabSongs"
                                     AutomationProperties.AutomationId="LibraryTabSongs" />
                    <SelectorBarItem x:Name="TabHistory" x:Uid="LibraryTabHistory"
                                     AutomationProperties.AutomationId="LibraryTabHistory" />
                    <SelectorBarItem x:Name="TabDownloads" x:Uid="LibraryTabDownloads"
                                     AutomationProperties.AutomationId="LibraryTabDownloads" />
                </SelectorBar>
            </ScrollViewer>

            <!-- Loading / error -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,48,0,0"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="32" Height="32" />
                <TextBlock x:Uid="LoadingText" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Error"
                     x:Uid="ErrorInfoBar"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     AutomationProperties.AutomationId="LibraryError">
                <InfoBar.ActionButton>
                    <Button x:Uid="RetryButton" Command="{x:Bind ViewModel.RefreshCommand}"
                            AutomationProperties.AutomationId="LibraryRetry" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Favorites: the count line only earns its place when
                 there is something to count (AUDIT_2 V-11). -->
            <StackPanel x:Name="FavoritesPanel" Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.FavoritesCountText, Mode=OneWay}"
                           Style="{StaticResource SecondaryCaptionStyle}"
                           Visibility="{x:Bind ViewModel.HasFavorites, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <StackPanel Style="{StaticResource EmptyStatePanelStyle}"
                            Visibility="{x:Bind ViewModel.HasFavorites, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xEB51;" FontSize="40" HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Uid="FavoritesEmptyTitle" Style="{StaticResource EmptyStateHeadlineStyle}" />
                    <TextBlock x:Uid="FavoritesEmpty" Style="{StaticResource EmptyStateGuidanceStyle}" />
                </StackPanel>
                <ListView ItemsSource="{x:Bind ViewModel.Favorites, Mode=OneWay}"
                          ItemTemplate="{StaticResource SongRowItemTemplate}"
                          ItemContainerStyle="{StaticResource RowItemContainerStyle}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="SongRow_ItemClick"
                          AutomationProperties.AutomationId="LibraryFavoritesList" />
            </StackPanel>

            <!-- Playlists (tab 1) -->
            <StackPanel x:Name="PlaylistsPanel" Spacing="12" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.PlaylistsCountText, Mode=OneWay}"
                               Style="{StaticResource SecondaryCaptionStyle}"
                               VerticalAlignment="Center" />
                    <Button x:Uid="CreatePlaylistButton" Click="CreatePlaylist_Click"
                            MinHeight="44"
                            AutomationProperties.AutomationId="LibraryCreatePlaylist" />
                </StackPanel>
                <StackPanel Style="{StaticResource EmptyStatePanelStyle}"
                            Visibility="{x:Bind ViewModel.HasPlaylists, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xEA37;" FontSize="40" HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Uid="PlaylistsEmptyTitle" Style="{StaticResource EmptyStateHeadlineStyle}" />
                    <TextBlock x:Uid="PlaylistsEmpty" Style="{StaticResource EmptyStateGuidanceStyle}" />
                    <Button x:Uid="CreatePlaylistButton" Click="CreatePlaylist_Click"
                            MinHeight="44" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListView Grid.Column="0"
                              ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                              ItemTemplate="{StaticResource PlaylistRowTemplate}"
                              ItemContainerStyle="{StaticResource RowItemContainerStyle}"
                              SelectedItem="{x:Bind ViewModel.SelectedPlaylist, Mode=TwoWay}"
                              SelectionMode="Single"
                              AutomationProperties.AutomationId="LibraryPlaylistsList" />
                    <StackPanel Grid.Column="1" Spacing="8"
                                Visibility="{x:Bind ViewModel.HasSelectedPlaylist, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ViewModel.SelectedPlaylist.Name, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="PlayAllButton" Command="{x:Bind ViewModel.PlaySelectedPlaylistCommand}"
                                    Style="{ThemeResource AccentButtonStyle}" MinHeight="44"
                                    AutomationProperties.AutomationId="LibraryPlaylistPlayAll" />
                            <Button x:Uid="RenamePlaylistButton" Click="RenamePlaylist_Click"
                                    MinHeight="44"
                                    AutomationProperties.AutomationId="LibraryPlaylistRename" />
                            <Button x:Uid="DeletePlaylistButton" Click="DeletePlaylist_Click"
                                    MinHeight="44"
                                    AutomationProperties.AutomationId="LibraryPlaylistDelete" />
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind ViewModel.PlaylistSongs, Mode=OneWay}"
                                  ItemTemplate="{StaticResource SongRowItemTemplate}"
                                  ItemContainerStyle="{StaticResource RowItemContainerStyle}"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="SongRow_ItemClick"
                                  AutomationProperties.AutomationId="LibraryPlaylistSongsList" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Artists (tab 2) -->
            <StackPanel x:Name="ArtistsPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="{x:Bind ViewModel.ArtistsCountText, Mode=OneWay}"
                           Style="{StaticResource SecondaryCaptionStyle}" />
                <TextBlock x:Uid="ArtistsEmpty" Style="{StaticResource EmptyStateGuidanceStyle}"
                           Visibility="{x:Bind ViewModel.HasArtists, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                <GridView ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}"
                          ItemTemplate="{StaticResource GroupTileTemplate}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="Group_ItemClick"
                          AutomationProperties.AutomationId="LibraryArtistsGrid" />
            </StackPanel>

            <!-- Albums (tab 3) -->
            <StackPanel x:Name="AlbumsPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="{x:Bind ViewModel.AlbumsCountText, Mode=OneWay}"
                           Style="{StaticResource SecondaryCaptionStyle}" />
                <TextBlock x:Uid="AlbumsEmpty" Style="{StaticResource EmptyStateGuidanceStyle}"
                           Visibility="{x:Bind ViewModel.HasAlbums, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                <GridView ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                          ItemTemplate="{StaticResource GroupTileTemplate}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="Group_ItemClick"
                          AutomationProperties.AutomationId="LibraryAlbumsGrid" />
            </StackPanel>

            <!-- Songs (tab 4): the whole local union, optionally
                 filtered to one artist/album group. -->
            <StackPanel x:Name="SongsPanel" Spacing="8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.SongsCountText, Mode=OneWay}"
                               Style="{StaticResource SecondaryCaptionStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.HasSongsFilter, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ViewModel.SongsFilterText, Mode=OneWay}"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button x:Uid="SongsFilterClearButton" Command="{x:Bind ViewModel.ClearSongsFilterCommand}"
                                MinHeight="44"
                                AutomationProperties.AutomationId="LibrarySongsFilterClear" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Uid="SongsEmpty" Style="{StaticResource EmptyStateGuidanceStyle}"
                           Visibility="{x:Bind ViewModel.HasSongs, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                <ListView ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                          ItemTemplate="{StaticResource SongRowItemTemplate}"
                          ItemContainerStyle="{StaticResource RowItemContainerStyle}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="SongRow_ItemClick"
                          AutomationProperties.AutomationId="LibrarySongsList" />
            </StackPanel>

            <!-- History (tab 5) -->
            <StackPanel x:Name="HistoryPanel" Spacing="8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.HistoryCountText, Mode=OneWay}"
                               Style="{StaticResource SecondaryCaptionStyle}"
                               VerticalAlignment="Center" />
                    <Button x:Uid="ClearHistoryButton" Click="ClearHistory_Click"
                            MinHeight="44"
                            AutomationProperties.AutomationId="LibraryClearHistory" />
                </StackPanel>
                <StackPanel Style="{StaticResource EmptyStatePanelStyle}"
                            Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE81C;" FontSize="40" HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Uid="HistoryEmptyTitle" Style="{StaticResource EmptyStateHeadlineStyle}" />
                    <TextBlock x:Uid="HistoryEmpty" Style="{StaticResource EmptyStateGuidanceStyle}" />
                </StackPanel>
                <ListView ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}"
                          ItemTemplate="{StaticResource SongRowItemTemplate}"
                          ItemContainerStyle="{StaticResource RowItemContainerStyle}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="SongRow_ItemClick"
                          AutomationProperties.AutomationId="LibraryHistoryList" />
            </StackPanel>

            <!-- Downloads (tab 6): row click plays completed downloads
                 from the local file and retries failed ones. -->
            <StackPanel x:Name="DownloadsPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="{x:Bind ViewModel.DownloadsCountText, Mode=OneWay}"
                           Style="{StaticResource SecondaryCaptionStyle}"
                           Visibility="{x:Bind ViewModel.HasDownloads, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <StackPanel Style="{StaticResource EmptyStatePanelStyle}"
                            Visibility="{x:Bind ViewModel.HasDownloads, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE896;" FontSize="40" HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Uid="DownloadsEmptyTitle" Style="{StaticResource EmptyStateHeadlineStyle}" />
                    <TextBlock x:Uid="DownloadsEmpty" Style="{StaticResource EmptyStateGuidanceStyle}" />
                </StackPanel>
                <ListView ItemsSource="{x:Bind ViewModel.Downloads, Mode=OneWay}"
                          ItemTemplate="{StaticResource DownloadRowTemplate}"
                          ItemContainerStyle="{StaticResource RowItemContainerStyle}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="DownloadsList_ItemClick"
                          AutomationProperties.AutomationId="LibraryDownloadsList" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
