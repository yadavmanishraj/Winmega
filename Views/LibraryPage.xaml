<Page
    x:Class="Omega.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Phase 0/1 placeholder. The real Library (design §9.4) is all-local
         (Microsoft.Data.Sqlite): Favourites / Downloads / History /
         Playlists behind a SelectorBar. -->
    <StackPanel Padding="24" Spacing="16">
        <TextBlock x:Uid="LibraryTitle" Style="{ThemeResource TitleTextBlockStyle}" />
        <TextBlock x:Uid="LibrarySubtitle" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.8" />
    </StackPanel>
</Page>
