<Page
    x:Class="Omega.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Omega.ViewModels">

    <!-- Home (design §9.2): hero Grid over the top trending entity +
         browse-module sections. Fluent rules: theme text styles only,
         4px spacing multiples, theme brushes only, hero surface 16px.
         Sections hide entirely when empty; errors are an InfoBar with
         Retry. The song-row template is the shared one in App.xaml. -->
    <Page.Resources>
        <DataTemplate x:Key="HomeRowTemplate" x:DataType="vm:HomeItemViewModel">
            <Grid ColumnSpacing="12" Padding="4,4" MinHeight="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{x:Bind Artwork}" Width="48" Height="48" Stretch="UniformToFill"
                       AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryCaptionStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                        Command="{x:Bind PlayCommand}"
                        Visibility="{x:Bind IsPlayable, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="HomeEntityPlayButton"
                        AutomationProperties.Name="{x:Bind PlayName}">
                    <FontIcon Glyph="&#xE768;" FontSize="18" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HomeTileTemplate" x:DataType="vm:HomeItemViewModel">
            <StackPanel Width="136" Spacing="6">
                <Image Source="{x:Bind Artwork}" Width="136" Height="136" Stretch="UniformToFill"
                       AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryCaptionStyle}"
                           TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24,24,24,24" Spacing="24">

            <!-- Hero: the entity is the headline (AUDIT_2 V-07) — the
                 greeting is demoted above it, the tint token washes
                 the card's right side so the card doesn't read as a
                 half-empty slab, and the text column is capped. -->
            <Border Style="{StaticResource HeroCardStyle}"
                    Visibility="{x:Bind ViewModel.HasHero, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Border HorizontalAlignment="Right" Width="288" CornerRadius="12"
                            Background="{ThemeResource HeroTintBrush}"
                            AutomationProperties.AccessibilityView="Raw" />
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{x:Bind ViewModel.Hero.LargeArtwork, Mode=OneWay}"
                               Width="144" Height="144" Stretch="UniformToFill"
                               AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"
                                    MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Hero.Title, Mode=OneWay}"
                                       Style="{ThemeResource TitleTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Uid="HomeSubtitle" Style="{StaticResource SecondaryTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button x:Uid="HomeHeroPlayButton"
                                        Command="{x:Bind ViewModel.PlayHeroCommand}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        MinWidth="48" MinHeight="48"
                                        AutomationProperties.AutomationId="HomeHeroPlay" />
                                <Button x:Uid="OpenButton"
                                        Click="HeroOpen_Click"
                                        MinHeight="48"
                                        Visibility="{x:Bind ViewModel.Hero.IsNavigable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="HomeHeroOpen" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Loading / error: the loading row is centred in the
                 content column, not stranded in the corner (V-19), and
                 the error bar cannot be dismissed into a dead end
                 (V-20). -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,48,0,0"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="32" Height="32" />
                <TextBlock x:Uid="LoadingText" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Error"
                     x:Uid="ErrorInfoBar"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     AutomationProperties.AutomationId="HomeError">
                <InfoBar.ActionButton>
                    <Button x:Uid="RetryButton" Command="{x:Bind ViewModel.RefreshCommand}"
                            AutomationProperties.AutomationId="HomeRetry" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Jump back in (local history) -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.HasJumpBackIn, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock x:Uid="SectionJumpBackIn" Style="{StaticResource SectionHeaderStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.JumpBackInItems, Mode=OneWay}"
                          ItemTemplate="{StaticResource SongRowTemplate}"
                          ItemContainerStyle="{StaticResource RowItemContainerStyle}"
                          SelectionMode="None"
                          AutomationProperties.AutomationId="HomeJumpBackInList" />
            </StackPanel>

            <!-- Trending songs -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.HasTrending, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock x:Uid="SectionTrending" Style="{StaticResource SectionHeaderStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.TrendingItems, Mode=OneWay}"
                          ItemTemplate="{StaticResource HomeRowTemplate}"
                          ItemContainerStyle="{StaticResource RowItemContainerStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="EntityList_ItemClick"
                          AutomationProperties.AutomationId="HomeTrendingList" />
            </StackPanel>

            <!-- New albums -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.HasNewAlbums, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock x:Uid="SectionNewAlbums" Style="{StaticResource SectionHeaderStyle}" />
                <GridView ItemsSource="{x:Bind ViewModel.NewAlbumItems, Mode=OneWay}"
                          ItemTemplate="{StaticResource HomeTileTemplate}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="EntityList_ItemClick"
                          AutomationProperties.AutomationId="HomeNewAlbumsGrid" />
            </StackPanel>

            <!-- Charts -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.HasCharts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock x:Uid="SectionCharts" Style="{StaticResource SectionHeaderStyle}" />
                <GridView ItemsSource="{x:Bind ViewModel.ChartItems, Mode=OneWay}"
                          ItemTemplate="{StaticResource HomeTileTemplate}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="EntityList_ItemClick"
                          AutomationProperties.AutomationId="HomeChartsGrid" />
            </StackPanel>

            <!-- Top playlists -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.HasTopPlaylists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock x:Uid="SectionTopPlaylists" Style="{StaticResource SectionHeaderStyle}" />
                <GridView ItemsSource="{x:Bind ViewModel.TopPlaylistItems, Mode=OneWay}"
                          ItemTemplate="{StaticResource HomeTileTemplate}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="EntityList_ItemClick"
                          AutomationProperties.AutomationId="HomeTopPlaylistsGrid" />
            </StackPanel>

            <!-- Browse discover (channels — shape rules still apply) -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.HasDiscover, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock x:Uid="SectionDiscover" Style="{StaticResource SectionHeaderStyle}" />
                <GridView ItemsSource="{x:Bind ViewModel.DiscoverItems, Mode=OneWay}"
                          ItemTemplate="{StaticResource HomeTileTemplate}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="EntityList_ItemClick"
                          AutomationProperties.AutomationId="HomeDiscoverGrid" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
