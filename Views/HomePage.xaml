<Page
    x:Class="Omega.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Omega.ViewModels">

    <!-- Home (HOME_PAGE_DESIGN, approved 2026-10-07): hero over the
         top trending entity, then EVERY section is the same anatomy —
         header + a 2-row card grid (ItemsWrapGrid, Orientation=
         Horizontal, MaximumRowsOrColumns=2) that scrolls horizontally
         as a whole. Two card types only: EntityCardTemplate (200px
         artwork) and the 304x72 song cards (SongCardTemplate for real
         songs, TrendingCardTemplate for HomeItemViewModel rows).
         Chevron paging + wheel-to-horizontal chaining live in
         code-behind (SectionScroller); section grids cap at 30 items
         (HomeViewModel fill). Templates are page-local (D1: bindings
         in a merged-dictionary template never evaluated). Sections
         hide entirely when empty; errors are an InfoBar with Retry. -->
    <Page.Resources>
        <!-- Entity card: square-ish artwork frame (tint placeholder +
             glyph behind the image) over a 2-line title and 1-line
             subtitle. The cell is artwork + 16 (ItemsWrapGrid sizes
             come from code-behind per responsive tier); the artwork
             row absorbs the text block's height variance so art stays
             ~square. The play disc is hover-revealed by code-behind
             (EntityGrid_ContainerContentChanging); it starts visible
             so a wiring miss degrades to an always-visible button. -->
        <DataTemplate x:Key="EntityCardTemplate" x:DataType="vm:HomeItemViewModel">
            <Grid Padding="8,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="8"
                        Background="{ThemeResource HeroTintBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xE8D6;" FontSize="40"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <Image Source="{x:Bind Artwork}" Stretch="UniformToFill"
                               AutomationProperties.AccessibilityView="Raw" />
                        <Button Width="44" Height="44" Padding="0" CornerRadius="22"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,8,8" BorderThickness="0"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Command="{x:Bind PlayCommand}"
                                Visibility="{x:Bind IsPlayable, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.AutomationId="HomeEntityPlayButton"
                                AutomationProperties.Name="{x:Bind PlayName}">
                            <FontIcon Glyph="&#xE768;" FontSize="16"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Button>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{x:Bind Title}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="2" Text="{x:Bind Subtitle}"
                           Style="{StaticResource SecondaryCaptionStyle}"
                           TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <!-- Song card (Jump back in): 304x72 card surface in a 320x88
             cell. Artwork carries the SongRow-style hover play disc;
             the card itself plays through the page's ItemClick. -->
        <DataTemplate x:Key="SongCardTemplate" x:DataType="vm:SongItemViewModel">
            <Grid Padding="8">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid Padding="8,0,12,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="56" Height="56" VerticalAlignment="Center">
                            <Border CornerRadius="4"
                                    Background="{ThemeResource HeroTintBrush}">
                                <FontIcon Glyph="&#xE8D6;" FontSize="20"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                            <Image Source="{x:Bind Artwork}" Width="56" Height="56"
                                   Stretch="UniformToFill"
                                   AutomationProperties.AccessibilityView="Raw" />
                            <Button Width="28" Height="28" Padding="0" CornerRadius="14"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderThickness="0"
                                    Command="{x:Bind PlayCommand}"
                                    AutomationProperties.AutomationId="SongArtworkPlayButton"
                                    AutomationProperties.Name="Play">
                                <FontIcon Glyph="&#xE768;" FontSize="12" />
                            </Button>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Title}"
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Artists}"
                                       Style="{StaticResource SecondaryCaptionStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind DurationText}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Trending card: the song-card chrome bound to
             HomeItemViewModel (Title/Subtitle/Artwork). The right slot
             keeps the row template's always-visible play button —
             trending items carry no duration. -->
        <DataTemplate x:Key="TrendingCardTemplate" x:DataType="vm:HomeItemViewModel">
            <Grid Padding="8">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid Padding="8,0,4,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="56" Height="56" VerticalAlignment="Center">
                            <Border CornerRadius="4"
                                    Background="{ThemeResource HeroTintBrush}">
                                <FontIcon Glyph="&#xE8D6;" FontSize="20"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                            <Image Source="{x:Bind Artwork}" Width="56" Height="56"
                                   Stretch="UniformToFill"
                                   AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Title}"
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Subtitle}"
                                       Style="{StaticResource SecondaryCaptionStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                VerticalAlignment="Center"
                                Command="{x:Bind PlayCommand}"
                                Visibility="{x:Bind IsPlayable, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.AutomationId="HomeEntityPlayButton"
                                AutomationProperties.Name="{x:Bind PlayName}">
                            <FontIcon Glyph="&#xE768;" FontSize="18" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Section grid containers sit flush: the templates carry
             the only inset (16px card gaps baked into the cells). -->
        <Style x:Key="HomeGridItemStyle" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,24,32,24" Spacing="40">

            <!-- Hero: the entity is the headline (AUDIT_2 V-07) — the
                 greeting is demoted above it, the tint token washes
                 the card's right side so the card doesn't read as a
                 half-empty slab, and the text column is capped.
                 Height ~168 (design §5): 128 artwork + card padding. -->
            <Border Style="{StaticResource HeroCardStyle}" MinHeight="168"
                    Visibility="{x:Bind ViewModel.HasHero, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Border HorizontalAlignment="Right" Width="288" CornerRadius="12"
                            Background="{ThemeResource HeroTintBrush}"
                            AutomationProperties.AccessibilityView="Raw" />
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{x:Bind ViewModel.Hero.LargeArtwork, Mode=OneWay}"
                               Width="128" Height="128" Stretch="UniformToFill"
                               AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"
                                    MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Hero.Title, Mode=OneWay}"
                                       Style="{ThemeResource TitleTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Uid="HomeSubtitle" Style="{StaticResource SecondaryTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button x:Uid="HomeHeroPlayButton"
                                        Command="{x:Bind ViewModel.PlayHeroCommand}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        MinWidth="48" MinHeight="48"
                                        AutomationProperties.AutomationId="HomeHeroPlay" />
                                <Button x:Uid="OpenButton"
                                        Click="HeroOpen_Click"
                                        MinHeight="48"
                                        Visibility="{x:Bind ViewModel.Hero.IsNavigable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="HomeHeroOpen" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Loading / error: the loading row is centred in the
                 content column, not stranded in the corner (V-19), and
                 the error bar cannot be dismissed into a dead end
                 (V-20). -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,48,0,0"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="32" Height="32" />
                <TextBlock x:Uid="LoadingText" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Error"
                     x:Uid="ErrorInfoBar"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     AutomationProperties.AutomationId="HomeError">
                <InfoBar.ActionButton>
                    <Button x:Uid="RetryButton" Command="{x:Bind ViewModel.RefreshCommand}"
                            AutomationProperties.AutomationId="HomeRetry" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Jump back in (local history) — song cards -->
            <StackPanel x:Name="JumpBackInSection" Spacing="12"
                        Visibility="{x:Bind ViewModel.HasJumpBackIn, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <TextBlock x:Uid="SectionJumpBackIn" Style="{StaticResource SectionHeaderStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button x:Name="JumpBackInScrollPrev" Style="{StaticResource IconButtonStyle}"
                                Width="36" Height="36" CornerRadius="18"
                                AutomationProperties.AutomationId="HomeJumpBackInScrollPrev"
                                AutomationProperties.Name="Scroll back">
                            <FontIcon Glyph="&#xE76B;" FontSize="14" />
                        </Button>
                        <Button x:Name="JumpBackInScrollNext" Style="{StaticResource IconButtonStyle}"
                                Width="36" Height="36" CornerRadius="18"
                                AutomationProperties.AutomationId="HomeJumpBackInScrollNext"
                                AutomationProperties.Name="Scroll forward">
                            <FontIcon Glyph="&#xE76C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <GridView x:Name="JumpBackInGrid"
                          ItemsSource="{x:Bind ViewModel.JumpBackInItems, Mode=OneWay}"
                          ItemTemplate="{StaticResource SongCardTemplate}"
                          ItemContainerStyle="{StaticResource HomeGridItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="SongRow_ItemClick"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="HomeJumpBackInList">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"
                                           ItemWidth="320" ItemHeight="88" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </StackPanel>

            <!-- Trending songs — song-card chrome, entity items -->
            <StackPanel x:Name="TrendingSection" Spacing="12"
                        Visibility="{x:Bind ViewModel.HasTrending, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <TextBlock x:Uid="SectionTrending" Style="{StaticResource SectionHeaderStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button x:Name="TrendingScrollPrev" Style="{StaticResource IconButtonStyle}"
                                Width="36" Height="36" CornerRadius="18"
                                AutomationProperties.AutomationId="HomeTrendingScrollPrev"
                                AutomationProperties.Name="Scroll back">
                            <FontIcon Glyph="&#xE76B;" FontSize="14" />
                        </Button>
                        <Button x:Name="TrendingScrollNext" Style="{StaticResource IconButtonStyle}"
                                Width="36" Height="36" CornerRadius="18"
                                AutomationProperties.AutomationId="HomeTrendingScrollNext"
                                AutomationProperties.Name="Scroll forward">
                            <FontIcon Glyph="&#xE76C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <GridView x:Name="TrendingGrid"
                          ItemsSource="{x:Bind ViewModel.TrendingItems, Mode=OneWay}"
                          ItemTemplate="{StaticResource TrendingCardTemplate}"
                          ItemContainerStyle="{StaticResource HomeGridItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="EntityList_ItemClick"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="HomeTrendingList">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"
                                           ItemWidth="320" ItemHeight="88" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </StackPanel>

            <!-- New albums — entity cards -->
            <StackPanel x:Name="NewAlbumsSection" Spacing="12"
                        Visibility="{x:Bind ViewModel.HasNewAlbums, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <TextBlock x:Uid="SectionNewAlbums" Style="{StaticResource SectionHeaderStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button x:Name="NewAlbumsScrollPrev" Style="{StaticResource IconButtonStyle}"
                                Width="36" Height="36" CornerRadius="18"
                                AutomationProperties.AutomationId="HomeNewAlbumsScrollPrev"
                                AutomationProperties.Name="Scroll back">
                            <FontIcon Glyph="&#xE76B;" FontSize="14" />
                        </Button>
                        <Button x:Name="NewAlbumsScrollNext" Style="{StaticResource IconButtonStyle}"
                                Width="36" Height="36" CornerRadius="18"
                                AutomationProperties.AutomationId="HomeNewAlbumsScrollNext"
                                AutomationProperties.Name="Scroll forward">
                            <FontIcon Glyph="&#xE76C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <GridView x:Name="NewAlbumsGrid"
                          ItemsSource="{x:Bind ViewModel.NewAlbumItems, Mode=OneWay}"
                          ItemTemplate="{StaticResource EntityCardTemplate}"
                          ItemContainerStyle="{StaticResource HomeGridItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="EntityList_ItemClick"
                          ContainerContentChanging="EntityGrid_ContainerContentChanging"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="HomeNewAlbumsGrid">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"
                                           ItemWidth="216" ItemHeight="268" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </StackPanel>

            <!-- Charts — entity cards -->
            <StackPanel x:Name="ChartsSection" Spacing="12"
                        Visibility="{x:Bind ViewModel.HasCharts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <TextBlock x:Uid="SectionCharts" Style="{StaticResource SectionHeaderStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button x:Name="ChartsScrollPrev" Style="{StaticResource IconButtonStyle}"
                                Width="36" Height="36" CornerRadius="18"
                                AutomationProperties.AutomationId="HomeChartsScrollPrev"
                                AutomationProperties.Name="Scroll back">
                            <FontIcon Glyph="&#xE76B;" FontSize="14" />
                        </Button>
                        <Button x:Name="ChartsScrollNext" Style="{StaticResource IconButtonStyle}"
                                Width="36" Height="36" CornerRadius="18"
                                AutomationProperties.AutomationId="HomeChartsScrollNext"
                                AutomationProperties.Name="Scroll forward">
                            <FontIcon Glyph="&#xE76C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <GridView x:Name="ChartsGrid"
                          ItemsSource="{x:Bind ViewModel.ChartItems, Mode=OneWay}"
                          ItemTemplate="{StaticResource EntityCardTemplate}"
                          ItemContainerStyle="{StaticResource HomeGridItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="EntityList_ItemClick"
                          ContainerContentChanging="EntityGrid_ContainerContentChanging"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="HomeChartsGrid">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"
                                           ItemWidth="216" ItemHeight="268" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </StackPanel>

            <!-- Top playlists — entity cards -->
            <StackPanel x:Name="TopPlaylistsSection" Spacing="12"
                        Visibility="{x:Bind ViewModel.HasTopPlaylists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <TextBlock x:Uid="SectionTopPlaylists" Style="{StaticResource SectionHeaderStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button x:Name="TopPlaylistsScrollPrev" Style="{StaticResource IconButtonStyle}"
                                Width="36" Height="36" CornerRadius="18"
                                AutomationProperties.AutomationId="HomeTopPlaylistsScrollPrev"
                                AutomationProperties.Name="Scroll back">
                            <FontIcon Glyph="&#xE76B;" FontSize="14" />
                        </Button>
                        <Button x:Name="TopPlaylistsScrollNext" Style="{StaticResource IconButtonStyle}"
                                Width="36" Height="36" CornerRadius="18"
                                AutomationProperties.AutomationId="HomeTopPlaylistsScrollNext"
                                AutomationProperties.Name="Scroll forward">
                            <FontIcon Glyph="&#xE76C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <GridView x:Name="TopPlaylistsGrid"
                          ItemsSource="{x:Bind ViewModel.TopPlaylistItems, Mode=OneWay}"
                          ItemTemplate="{StaticResource EntityCardTemplate}"
                          ItemContainerStyle="{StaticResource HomeGridItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="EntityList_ItemClick"
                          ContainerContentChanging="EntityGrid_ContainerContentChanging"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="HomeTopPlaylistsGrid">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"
                                           ItemWidth="216" ItemHeight="268" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </StackPanel>

            <!-- Browse discover (channels — shape rules still apply) -->
            <StackPanel x:Name="DiscoverSection" Spacing="12"
                        Visibility="{x:Bind ViewModel.HasDiscover, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <TextBlock x:Uid="SectionDiscover" Style="{StaticResource SectionHeaderStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button x:Name="DiscoverScrollPrev" Style="{StaticResource IconButtonStyle}"
                                Width="36" Height="36" CornerRadius="18"
                                AutomationProperties.AutomationId="HomeDiscoverScrollPrev"
                                AutomationProperties.Name="Scroll back">
                            <FontIcon Glyph="&#xE76B;" FontSize="14" />
                        </Button>
                        <Button x:Name="DiscoverScrollNext" Style="{StaticResource IconButtonStyle}"
                                Width="36" Height="36" CornerRadius="18"
                                AutomationProperties.AutomationId="HomeDiscoverScrollNext"
                                AutomationProperties.Name="Scroll forward">
                            <FontIcon Glyph="&#xE76C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <GridView x:Name="DiscoverGrid"
                          ItemsSource="{x:Bind ViewModel.DiscoverItems, Mode=OneWay}"
                          ItemTemplate="{StaticResource EntityCardTemplate}"
                          ItemContainerStyle="{StaticResource HomeGridItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="EntityList_ItemClick"
                          ContainerContentChanging="EntityGrid_ContainerContentChanging"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="HomeDiscoverGrid">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"
                                           ItemWidth="216" ItemHeight="268" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
